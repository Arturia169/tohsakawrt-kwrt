#!/bin/sh
# TohsakaWrt 统一周期巡检器 (Unified Periodic Watchdog)
# 每分钟由 cron 调度一次，按序低开销执行温度巡检、服务巡检与模组自愈。

[ -r /usr/lib/tohsakawrt/common.sh ] && . /usr/lib/tohsakawrt/common.sh

# 1. CPU 温度监控 (超温预警与回差恢复)
[ -x /usr/bin/tohsakawrt-temp-watch ] && /usr/bin/tohsakawrt-temp-watch >/dev/null 2>&1

# 2. 服务状态、外网IP变动、5G制式切换与大流量看门狗
[ -x /usr/bin/tohsakawrt-service-watch ] && /usr/bin/tohsakawrt-service-watch >/dev/null 2>&1

# 3. 模组脱网自愈检测 (内置 120s 速率限制保护)
[ -x /usr/bin/tohsakawrt-modem-heal ] && /usr/bin/tohsakawrt-modem-heal >/dev/null 2>&1

exit 0
