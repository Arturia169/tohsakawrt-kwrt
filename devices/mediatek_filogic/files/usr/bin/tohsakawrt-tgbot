💡 <i>提示：可以直接点击下方快捷按钮或消息内的内联按钮快速操作。</i>"
}

process_callback() {
    local cb_id="$1"
    local msg_id="$2"
    local cb_data="$3"

    case "$cb_data" in
        set_mode:*)
            local target_mode="${cb_data#set_mode:}"
            curl -s -X PATCH -H "Content-Type: application/json" -d "{\"mode\":\"${target_mode}\"}" http://127.0.0.1:9090/configs >/dev/null 2>&1
            local mode_name=""
            case "$target_mode" in
                rule) mode_name="规则分流 (Rule)" ;;
                global) mode_name="全局代理 (Global)" ;;
                direct) mode_name="全局直连 (Direct)" ;;
                *) mode_name="$target_mode" ;;
            esac

            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=已切换为: ${mode_name}" >/dev/null 2>&1

            local now="$(date '+%Y-%m-%d %H:%M:%S')"
            local new_text="✅ <b>OpenClash 模式切换成功</b>

━━━━━━━━━━━━━━
🔀 <b>当前模式</b>：<code>${mode_name}</code>
━━━━━━━━━━━━━━
👇 点击可再次切换："
            local inline_kb='{"inline_keyboard":[[{"text":"📐 规则分流","callback_data":"set_mode:rule"},{"text":"🌐 全局代理","callback_data":"set_mode:global"},{"text":"⚡ 全局直连","callback_data":"set_mode:direct"}]]}'
            curl -m 5 -fsS -X POST "${API}/editMessageText" \
                -d "chat_id=${CHAT_ID}" \
                -d "message_id=${msg_id}" \
                -d "parse_mode=HTML" \
                -d "reply_markup=${inline_kb}" \
                --data-urlencode "text=${new_text}" >/dev/null 2>&1
            ;;
        test_nodes)
            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=⚡ 正在后台测速，请稍候约2秒..." >/dev/null 2>&1
            curl -s -m 5 "http://127.0.0.1:9090/group/%E2%99%BB%EF%B8%8F%20%E9%A6%99%E6%B8%AF%E8%87%AA%E5%8A%A8/delay?url=http%3A%2F%2Fcp.cloudflare.com%2Fgenerate_204&timeout=2500" >/dev/null 2>&1
            curl -s -m 5 "http://127.0.0.1:9090/group/%E2%99%BB%EF%B8%8F%20%E7%BE%8E%E5%9B%BD%E8%87%AA%E5%8A%A8/delay?url=http%3A%2F%2Fcp.cloudflare.com%2Fgenerate_204&timeout=2500" >/dev/null 2>&1
            cmd_nodes
            ;;
        restart_clash)
            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=🔄 正在重启 OpenClash..." >/dev/null 2>&1
            cmd_clash_restart
            ;;
        re_ping)
            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=🩺 正在重新测试网络质量，请稍候约2秒..." >/dev/null 2>&1
            cmd_ping
            ;;
        refresh_direct)
            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=🔄 正在刷新直连白名单..." >/dev/null 2>&1
            cmd_direct_list
            ;;
        set_uplink:*)
            local target_uplink="${cb_data#set_uplink:}"
            local res=""
            if [ -x /usr/bin/tohsakawrt-uplink ]; then
                res="$(/usr/bin/tohsakawrt-uplink set "$target_uplink" 2>/dev/null)"
            else
                res="ERROR_NO_TOOL"
            fi

            local notice_text=""
            local result_desc=""
            case "$res" in
                SUCCESS_WAN|ALREADY_WAN)
                    notice_text="已切换为主力有线宽带"
                    result_desc="🌐 <b>当前主力出口</b>：<code>有线光猫宽带 (eth0)</code>
⚡ <b>状态</b>：平滑倒换完成，网络连接零中断。"
                    ;;
                SUCCESS_5G|ALREADY_5G)
                    notice_text="已切换为主力 5G 模组"
                    result_desc="📶 <b>当前主力出口</b>：<code>5G 蜂窝模组 (usb0)</code>
⚡ <b>状态</b>：平滑倒换完成，已进入 5G 模组通道。"
                    ;;
                ERROR_5G_NO_IP)
                    notice_text="切换失败：5G 模组未获取到 IP"
                    result_desc="⚠️ <b>切换失败</b>：5G 模组 (usb0) 当前未获取到有效 IP，无法作为主力出口。"
                    ;;
                *)
                    notice_text="切换执行完成"
                    result_desc="ℹ️ 切换返回：<code>${res}</code>"
                    ;;
            esac

            curl -m 5 -fsS -X POST "${API}/answerCallbackQuery" \
                -d "callback_query_id=${cb_id}" \
                -d "text=${notice_text}" >/dev/null 2>&1

            local inline_kb='{"inline_keyboard":[[{"text":"🌐 切换至：有线宽带","callback_data":"set_uplink:wan"},{"text":"📶 切换至：5G模组","callback_data":"set_uplink:5g"}]]}'
            local now="$(date '+%Y-%m-%d %H:%M:%S')"
            local new_text="🔀 <b>网络主力出口切换</b>

━━━━━━━━━━━━━━
${result_desc}
━━━━━━━━━━━━━━
👇 点击下方按钮可再次倒换：

🕰️ <i>${now}</i>"

            curl -m 5 -fsS -X POST "${API}/editMessageText" \
                -d "chat_id=${CHAT_ID}" \
                -d "message_id=${msg_id}" \
                -d "parse_mode=HTML" \
                -d "reply_markup=${inline_kb}" \
                --data-urlencode "text=${new_text}" >/dev/null 2>&1
            ;;
    esac
}

process_command() {
    local raw_cmd="$1"
    local cmd arg

    if [ "${raw_cmd#/}" != "$raw_cmd" ]; then
        cmd="${raw_cmd%% *}"
        arg="${raw_cmd#* }"
        [ "$arg" = "$raw_cmd" ] && arg=""
        cmd="${cmd%%@*}"
    else
        cmd="$raw_cmd"
        arg=""
    fi

    case "$cmd" in
        /start|/help|/menu|*帮助*)
            cmd_help
            ;;
        /status|*状态*)
            cmd_status
            ;;
        /ping|/check|/test|*体检*|*双向*|*测速*)
            cmd_ping
            ;;
        /nodes|*节点*)
            cmd_nodes "$arg"
            ;;
        /mode|*模式*)
            cmd_mode "$arg"
            ;;
        /uplink|/switch_wan|*出口*|*切网*|*切5G*)
            cmd_uplink
            ;;
        /direct|/bypass|/unproxy|*加直连*)
            cmd_direct "$arg"
            ;;
        /undirect|/del_direct|/redirect|*删直连*)
            cmd_undirect "$arg"
            ;;
        /direct_list|/bypass_list|*直连*|*白名单*)
            if [ -n "$arg" ]; then
                cmd_direct "$arg"
            else
                cmd_direct_list
            fi
            ;;
        /clash_restart|*重启*|*核心*)
            cmd_clash_restart
            ;;
        /clients|/devices|*设备*|*客户端*)
            cmd_clients
            ;;
        /alias|*备注*)
            cmd_alias "$arg"
            ;;
        /temp|*温度*)
            cmd_temp
            ;;
        /wan|*外网*|*网络*)
            cmd_wan
            ;;
        /clash|*Clash*|*clash*)
            cmd_clash
            ;;
        /storage|*存储*)
            cmd_storage
            ;;
        /usb|*USB*|*usb*)
            cmd_usb
            ;;
        /modem|*5G*|*蜂窝*)
            cmd_modem
            ;;
        *)
            send_msg "⚠️ <b>未识别的命令</b>：<code>${cmd}</code>\n\n发送 /help 或点击下方键盘查看可用命令。"
            ;;
    esac
}

parse_updates() {
    lua -e '
local json = require "luci.jsonc"

local input = io.read("*a")
local data = json.parse(input)

if not data or not data.result then
    os.exit(0)
end

for _, u in ipairs(data.result) do
    local uid = tostring(u.update_id or "")
    if u.callback_query then
        local cq = u.callback_query
        local chat_id = (cq.message and cq.message.chat) and tostring(cq.message.chat.id) or ""
        local msg_id = (cq.message) and tostring(cq.message.message_id) or ""
        local data_str = tostring(cq.data or "")
        local cq_id = tostring(cq.id or "")
        io.write(uid, "\t", chat_id, "\t", "CALLBACK:" .. cq_id .. ":" .. msg_id .. ":" .. data_str, "\n")
    else
        local m = u.message or u.edited_message
        if m and m.chat then
            local text = tostring(m.text or "")
            text = text:gsub("[\r\n\t]", " ")
            io.write(uid, "\t", tostring(m.chat.id or ""), "\t", text, "\n")
        else
            io.write(uid, "\t\t\n")
        end
    end
end
'
}

# 第一次启动丢弃积压命令，同步到最新 offset
if [ ! -f "$OFFSET_FILE" ]; then
    INIT="$(
        curl -m 10 -fsS \
            "${API}/getUpdates?offset=-1&limit=1&timeout=0" \
            2>/dev/null
    )"

    LAST="$(
        printf '%s' "$INIT" |
        lua -e '
local json=require "luci.jsonc"
local d=json.parse(io.read("*a"))
if d and d.result and #d.result>0 then
    print((d.result[#d.result].update_id or 0)+1)
else
    print(0)
end
'
    )"

    echo "${LAST:-0}" > "$OFFSET_FILE"
    log "Telegram Bot started with offset ${LAST:-0}"
fi

while true; do
    OFFSET="$(cat "$OFFSET_FILE" 2>/dev/null)"
    [ -n "$OFFSET" ] || OFFSET=0

    RESPONSE="$(
        curl -m 35 --connect-timeout 8 -sS \
            --get "${API}/getUpdates" \
            --data-urlencode "offset=${OFFSET}" \
            --data-urlencode "timeout=25" \
            --data-urlencode 'allowed_updates=["message","edited_message","callback_query"]' \
            2>/dev/null
    )"

    # 如果返回包含 "ok":true，说明与 TG 服务器通讯正常
    if echo "$RESPONSE" | grep -q '"ok":true'; then
        BACKOFF=0

        printf '%s' "$RESPONSE" |
        parse_updates |
        while IFS="$(printf '\t')" read -r UPDATE_ID MSG_CHAT MSG_TEXT
        do
            [ -n "$UPDATE_ID" ] || continue

            NEXT=$((UPDATE_ID + 1))
            echo "$NEXT" > "$OFFSET_FILE"

            [ -n "$MSG_TEXT" ] || continue

            if [ "$MSG_CHAT" != "$CHAT_ID" ]; then
                log "Ignored unauthorized chat ${MSG_CHAT}"
                continue
            fi

            case "$MSG_TEXT" in
                CALLBACK:*)
                    cb_full="${MSG_TEXT#CALLBACK:}"
                    cb_id="${cb_full%%:*}"
                    rest="${cb_full#*:}"
                    msg_id="${rest%%:*}"
                    cb_data="${rest#*:}"
                    log "Callback: ${cb_data}"
                    process_callback "$cb_id" "$msg_id" "$cb_data"
                    ;;
                *)
                    log "Command: ${MSG_TEXT}"
                    process_command "$MSG_TEXT"
                    ;;
            esac
        done
        continue
    fi

    # 仅在真正网络断开时做短时等待 (最多 5 秒)
    if [ "$BACKOFF" -eq 0 ]; then
        BACKOFF=2
    else
        BACKOFF=$((BACKOFF + 1))
        [ "$BACKOFF" -gt 5 ] && BACKOFF=5
    fi

    log "Poll reconnecting in ${BACKOFF}s"
    sleep "$BACKOFF"
done
