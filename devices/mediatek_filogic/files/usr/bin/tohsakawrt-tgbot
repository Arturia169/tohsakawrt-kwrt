#!/bin/sh
# TohsakaWrt Telegram Bot Launcher (Native OpenWrt Lua Engine)

CONFIG="tohsakawrt-tgbot.main"

ENABLED="$(uci -q get ${CONFIG}.enabled)"
[ "$ENABLED" = "1" ] || exit 0

TOKEN="$(uci -q get ${CONFIG}.token)"
[ -n "$TOKEN" ] || exit 1

CHAT_ID="$(uci -q get ${CONFIG}.chat_id)"
[ -n "$CHAT_ID" ] || exit 1

if [ -f /usr/lib/lua/tohsakawrt/bot.lua ]; then
    exec lua -e 'require("tohsakawrt.bot").run()'
fi

exit 1
