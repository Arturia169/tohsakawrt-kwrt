#!/bin/sh
# TohsakaWrt：给 Clash 加"强制直连"域名
# 解决场景：技术博客/自建站套了已被优化的 CDN（落地在香港日本等），走代理反而更慢。
#
#   add <域名>   加入直连（写模块+写运行配置+热重载）
#   del <域名>   移除（同样两处+热重载）
#   list         列出清单
#   apply        只做热重载（手工改完模块后可用）
#   status       输出统计（给机器人用）
#
# 两个文件的分工（实机确认）：
#   MODULE  你手工维护的模块，带 TG_DIRECT_RULES 标记段 —— 保证持久（重启/重新生成后仍在）
#   RUNTIME 核心实际读取的配置（进程参数 -f /etc/openclash/config.yaml）—— 保证"立即生效"
# 热重载用 Mihomo 的 PUT /configs，保留现有连接，不重启 OpenClash。
#
# 但"保留现有连接"有个坑：热重载只影响之后新建的连接，浏览器/客户端已经建立的
# 长连接会继续走旧路线（实测一条添加前 41 秒建立的 keep-alive 能挂十几分钟），
# 用户体感就是"加了没生效"。所以重载成功后主动断掉该域名现存的连接，逼客户端重连。
set -u

MODULE="${TWR_CLASH_MODULE:-/etc/openclash/config/config.yaml}"
RUNTIME="${TWR_CLASH_RUNTIME:-/etc/openclash/config.yaml}"
API="${TWR_CLASH_API:-http://127.0.0.1:9090}"
RELOAD_BIN="${TWR_CLASH_RELOAD_BIN:-/usr/bin/tohsakawrt-clash-reload}"
START="# === TG_DIRECT_RULES_START ==="
END="# === TG_DIRECT_RULES_END ==="

# 用户常把整条网址粘进来（https://host/path、host:443、结尾带点），先归一成纯域名
norm_domain() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' \
        | sed -e 's#^[a-z][a-z0-9+.-]*://##' -e 's#^[^/@]*@##' \
              -e 's#[/?#].*$##' -e 's#:[0-9]*$##' -e 's#\.$##'
}

valid_domain() {
    case "$1" in
        ''|*[!a-zA-Z0-9.-]*) return 1 ;;
    esac
    printf '%s' "$1" | grep -Eq '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$'
}

already_in() {
    grep -qF "DOMAIN-SUFFIX,$1,直连" "$MODULE" 2>/dev/null
}

add_module() {
    grep -qF "$START" "$MODULE" 2>/dev/null || return 1
    awk -v rule="  - DOMAIN-SUFFIX,$1,直连" -v start="$START" '
        { print }
        $0 == start && !done { print rule; done = 1 }
    ' "$MODULE" > "$MODULE.tmp" && mv "$MODULE.tmp" "$MODULE"
}

del_module() {
    grep -vF "DOMAIN-SUFFIX,$1,直连" "$MODULE" > "$MODULE.tmp" 2>/dev/null && mv "$MODULE.tmp" "$MODULE"
}

# 运行配置里没有标记段（生成时注释被剥掉），所以插到 rules: 列表最前面 = 优先级最高
add_runtime() {
    grep -qE '^rules:' "$RUNTIME" 2>/dev/null || return 1
    grep -qF "DOMAIN-SUFFIX,$1,直连" "$RUNTIME" 2>/dev/null && return 0
    awk -v rule="- DOMAIN-SUFFIX,$1,直连" '
        { print }
        /^rules:/ && !done { print rule; done = 1 }
    ' "$RUNTIME" > "$RUNTIME.tmp" && mv "$RUNTIME.tmp" "$RUNTIME"
}

del_runtime() {
    grep -vF "DOMAIN-SUFFIX,$1,直连" "$RUNTIME" > "$RUNTIME.tmp" 2>/dev/null && mv "$RUNTIME.tmp" "$RUNTIME"
}

reload() {
    # 热重载只有一份实现：tohsakawrt-clash-reload（内核不退出，坏配置由它拦下）
    # 这里只做「调用 + 把退出码翻成机器人认识的 RELOAD_FAILED:<code>」。
    "$RELOAD_BIN" -q -c "$RUNTIME" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    echo "RELOAD_FAILED:$rc"
    return 1
}

# 断掉该域名现存的连接（热重载不会动它们）。只匹配 host 完全一致的连接，
# 不动 IP 直连和其它流量。输出 CLOSED:<条数>，机器人据此回话。
close_conns() {
    d="${1:-}"
    n=0
    if [ -n "$d" ]; then
        body="$(curl -s -m 8 "$API/connections" 2>/dev/null)"
        if [ -n "$body" ]; then
            ids="$(printf '%s' "$body" | awk -v want="\"host\":\"$d\"" '
                {
                    s = $0
                    while ((i = index(s, "{\"id\":\"")) > 0) {
                        s = substr(s, i + 7)
                        q = index(s, "\"")
                        if (q <= 1) break
                        id = substr(s, 1, q - 1)
                        rest = substr(s, q)
                        nx = index(rest, "{\"id\":\"")
                        seg = (nx > 0) ? substr(rest, 1, nx - 1) : rest
                        if (index(seg, want) > 0) print id
                        s = rest
                    }
                }')"
            for id in $ids; do
                code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 -X DELETE "$API/connections/$id" 2>/dev/null)"
                case "$code" in 200|204) n=$((n + 1)) ;; esac
            done
        fi
    fi
    echo "CLOSED:$n"
}

case "${1:-}" in
    add)
        d="$(norm_domain "${2:-}")"
        valid_domain "$d" || { echo "ERROR_BAD_DOMAIN"; exit 1; }
        [ -f "$MODULE" ] || { echo "ERROR_NO_MODULE"; exit 1; }
        if already_in "$d"; then
            echo "ALREADY"
        else
            cp -a "$MODULE" "$MODULE.bak-clashdirect-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
            add_module "$d" || { echo "ERROR_NO_MARKER"; exit 1; }
            echo "ADDED"
        fi
        add_runtime "$d" >/dev/null 2>&1 || true
        if reload; then close_conns "$d"; else echo "CLOSED:0"; fi
        ;;

    del)
        d="$(norm_domain "${2:-}")"
        valid_domain "$d" || { echo "ERROR_BAD_DOMAIN"; exit 1; }
        del_module "$d"
        del_runtime "$d"
        echo "DELETED"
        if reload; then close_conns "$d"; else echo "CLOSED:0"; fi
        ;;

    list)
        [ -f "$MODULE" ] || exit 0
        awk -v start="$START" -v end="$END" '
            $0 == start { inblock = 1; next }
            $0 == end { inblock = 0 }
            inblock && $0 ~ /DOMAIN-SUFFIX/ {
                line = $0
                sub(/^[ \t]*-[ \t]*DOMAIN-SUFFIX,/, "", line)
                sub(/,直连.*$/, "", line)
                print line
            }' "$MODULE"
        ;;

    apply)
        reload || { echo "ERROR_RELOAD"; exit 1; }
        echo "OK_RELOADED"
        ;;

    # 实测两条路，给建议（数字可比：都是"完成一次 HTTPS 请求"的耗时）
    #   直连 → Clash 的 DIRECT 出口（/proxies/DIRECT/delay）
    #   代理 → 走 Clash 的 HTTP 端口发同一请求（路径由现有规则决定 = 它平时的走向）
    smart)
        d="$(norm_domain "${2:-}")"
        valid_domain "$d" || { echo "ERROR_BAD_DOMAIN"; exit 1; }
        direct_json="$(curl -s -m 8 "$API/proxies/DIRECT/delay?url=https://$d/&timeout=5000" 2>/dev/null)"
        direct_ms="$(printf '%s' "$direct_json" | sed -n 's/.*"delay":\([0-9]*\).*/\1/p')"
        # 代理那一路也走 Clash 原生探测，与直连完全对称。
        # 为什么不用 curl -x 端口：实机确认代理端口启用了认证（authentication=Clash），
        # 未认证的 CONNECT 直接失败（HTTP 000）—— 只看耗时就会误判成"代理极快"。
        grp="${TWR_CLASH_SMART_GROUP:-$(uci -q get tohsakawrt-tgbot.main.clash_smart_group 2>/dev/null)}"
        [ -n "$grp" ] || grp="🚀 默认代理"
        grp_enc="$(printf '%s' "$grp" | sed 's/ /%20/g')"
        proxy_json="$(curl -s -m 10 "$API/proxies/$grp_enc/delay?url=https://$d/&timeout=5000" 2>/dev/null)"
        proxy_ms="$(printf '%s' "$proxy_json" | sed -n 's/.*"delay":\([0-9]*\).*/\1/p')"
        echo "DIRECT_MS:${direct_ms:-NA}"
        echo "PROXY_MS:${proxy_ms:-NA}"
        echo "PROXY_GROUP:${grp}"
        if [ -n "${direct_ms:-}" ] && [ -n "${proxy_ms:-}" ]; then
            if [ "$direct_ms" -lt "$proxy_ms" ]; then echo "VERDICT:DIRECT"; else echo "VERDICT:PROXY"; fi
        else
            echo "VERDICT:UNKNOWN"
        fi
        ;;

    status)
        n="$(sh "$0" list 2>/dev/null | wc -l)"
        echo "DIRECT_RULES:${n}"
        ;;

    *)
        echo "Usage: $0 {add <域名|网址> | del <域名|网址> | list | apply | status | smart <域名>}"
        exit 1
        ;;
esac
