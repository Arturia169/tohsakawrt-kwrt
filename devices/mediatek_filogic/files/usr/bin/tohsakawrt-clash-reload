#!/bin/sh
# TohsakaWrt：热重载 OpenClash 配置（内核不退出）
#
# 为什么需要它：/etc/init.d/openclash restart 会 停内核 → 删 nft 规则 → 重启 dnsmasq，
# 全程 17~24 秒；这期间所有连接都会断（包括规则判定为「直连」的那些，因为局域网
# 的 TCP 全被 nftables 重定向进内核 :7892），看直播/开会的体感就是卡一下。
#
# 这里改用 Mihomo 的 PUT /configs：内核进程不退出，配置先校验再原子替换，
# 校验不过直接返回 400 并保留旧配置 —— 改错了也不会把代理搞挂。
set -u

RUNTIME="${TWR_CLASH_RUNTIME:-/etc/openclash/config.yaml}"
INIT="${TWR_CLASH_INIT:-/etc/init.d/openclash}"
LOG="${TWR_CLASH_RELOAD_LOG:-/tmp/tohsakawrt-clash-reload.log}"
OVERWRITE="${TWR_CLASH_OVERWRITE:-/etc/openclash/custom/openclash_custom_overwrite.sh}"
LOCKFILE="${TWR_CLASH_RELOAD_LOCK:-/tmp/tohsakawrt-clash-reload.lock}"
TRIES="${TWR_CLASH_RELOAD_TRIES:-20}"

QUIET=0
APPLY_OVERWRITE=0
FORCE_RESTART=0
NO_RESTART=0

say() { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null; }

usage() {
    cat <<'EOF'
用法：
  tohsakawrt-clash-reload            重载 /etc/openclash/config.yaml
  tohsakawrt-clash-reload -c FILE    重载指定文件（须在 Mihomo 的 SAFE_PATHS 下，通常是 /etc/openclash）
  tohsakawrt-clash-reload -o         先跑一遍自定义覆盖脚本再重载（改了 overwrite 脚本时用）
  tohsakawrt-clash-reload -r         配置被内核拒绝时也强制完整重启（不推荐：重启救不了坏配置）
  tohsakawrt-clash-reload -n         接口不可达（内核没跑）时不要自动重启
  tohsakawrt-clash-reload -q         静默，只写日志

退出码：
  0 成功（含「接口不可达时自动重启成功」）
  1 参数/文件/覆盖脚本错误（什么都没做）
  2 配置被内核拒绝，旧配置仍在服务、连接未断（默认不会重启）
  3 内核不可用且重启失败或被 -n 禁止

注意：热重载只影响之后新建的连接；已经建立的长连接会继续走旧路线
（浏览器 keep-alive 能挂十几分钟），需要它们立刻生效就主动断开重连。
EOF
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        -c) [ $# -ge 2 ] || usage; RUNTIME="$2"; shift 2 ;;
        -o) APPLY_OVERWRITE=1; shift ;;
        -r) FORCE_RESTART=1; shift ;;
        -n) NO_RESTART=1; shift ;;
        -q) QUIET=1; shift ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
done

# 接口地址：优先环境变量（测试用），否则读 OpenClash 的端口配置
if [ -n "${TWR_CLASH_API:-}" ]; then
    API="$TWR_CLASH_API"
else
    port=""
    command -v uci >/dev/null 2>&1 && port="$(uci -q get openclash.config.cn_port 2>/dev/null)"
    [ -n "${port:-}" ] || port=9090
    API="http://127.0.0.1:$port"
fi

api_ok() { curl -s -m 5 "$API/version" 2>/dev/null | grep -q '"version"'; }

restart_core() {
    say "执行完整重启（约 20 秒，所有连接会断）..."
    log "RESTART_FALLBACK"
    "$INIT" restart >/dev/null 2>&1
    i=0
    while [ "$i" -lt "$TRIES" ]; do
        sleep 2
        i=$((i + 1))
        if api_ok; then
            say "重启完成，内核已就绪"
            log "RESTART_OK"
            return 0
        fi
    done
    say "重启后接口仍不可用，请看 /tmp/openclash.log"
    log "RESTART_FAILED"
    return 3
}

[ -r "$RUNTIME" ] || { say "配置文件不可读：$RUNTIME"; log "ERR_NO_CONFIG $RUNTIME"; exit 1; }

# 串行化：设备上的 flock 不支持 -w，用 -n 直接失败即可
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCKFILE" 2>/dev/null || true
    flock -n 9 2>/dev/null || { say "另一个实例正在运行"; exit 1; }
fi

# 改了自定义覆盖脚本时，先让它跑一遍（它本身要幂等，否则会重复插入）
if [ "$APPLY_OVERWRITE" -eq 1 ] && [ -f "$OVERWRITE" ]; then
    if ! sh "$OVERWRITE" "$RUNTIME" >/dev/null 2>&1; then
        say "自定义覆盖脚本执行失败，已中止（没有重载，旧配置继续服务）"
        log "ERR_OVERWRITE"
        exit 1
    fi
fi

resp="$(curl -s -m 20 -w '\n%{http_code}' -X PUT "$API/configs?force=true" \
    -H 'Content-Type: application/json' \
    --data "{\"path\":\"$RUNTIME\"}" 2>/dev/null)"
CODE="$(printf '%s' "$resp" | tail -n 1)"
BODY="$(printf '%s' "$resp" | sed '$d')"

case "$CODE" in
    200|204)
        if api_ok; then
            say "已热重载（内核未重启）：$RUNTIME"
            log "OK $RUNTIME"
            exit 0
        fi
        say "重载返回 $CODE，但接口随后无响应，回退完整重启"
        log "RELOAD_OK_BUT_DEAD"
        restart_core
        exit $?
        ;;
    000|'')
        say "Clash 接口不可达（内核没在运行？）"
        if [ "$NO_RESTART" -eq 1 ]; then
            log "API_DOWN_NO_RESTART"
            exit 3
        fi
        restart_core
        exit $?
        ;;
    *)
        say "配置被内核拒绝（HTTP $CODE）：$BODY"
        say "旧配置仍在服务，连接没有中断。"
        log "REJECTED $CODE $BODY"
        if [ "$FORCE_RESTART" -ne 1 ]; then
            exit 2
        fi
        say "按 -r 要求强制重启"
        restart_core
        exit $?
        ;;
esac
