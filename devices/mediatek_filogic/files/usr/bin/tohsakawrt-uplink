#!/bin/sh
# TohsakaWrt: 网络主力出口平滑切换工具 (WAN 宽带 eth0 <-> 5G 模组 usb0)

[ -r /usr/lib/tohsakawrt/common.sh ] && . /usr/lib/tohsakawrt/common.sh

get_active_dev() {
    ip route get 8.8.8.8 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
}

get_active_uplink() {
    local dev="$(get_active_dev)"
    case "$dev" in
        usb0) echo "5g" ;;
        eth0) echo "wan" ;;
        *) echo "${dev:-unknown}" ;;
    esac
}

normalize_metrics() {
    local wan_metric="$(uci -q get network.wan.metric 2>/dev/null)"
    local modem_metric="$(uci -q get network.5Ga.metric 2>/dev/null)"
    if [ "$wan_metric" = "20" ] || [ "$modem_metric" = "5" ]; then
        uci set network.wan.metric=10 2>/dev/null
        uci set network.5Ga.metric=20 2>/dev/null
        uci commit network 2>/dev/null
    fi
}

get_gateway() {
    ip route show default dev "$1" 2>/dev/null | sed -n 's/.* via \([^ ]*\).*/\1/p' | head -n 1
}

# 互斥：自愈会由巡检触发，可能与人工切换同时发生，必须串行（BusyBox flock 无 -w，用 -n 轮询）
LOCK_FILE="${TOHSAKA_UPLINK_LOCK:-/var/lock/tohsakawrt-uplink.lock}"
DESIRED_FILE="${TOHSAKA_UPLINK_DESIRED:-/etc/tohsakawrt/uplink.desired}"

acquire_uplink_lock() {
    command -v flock >/dev/null 2>&1 || return 0
    exec 9>"$LOCK_FILE" 2>/dev/null || return 0
    local i=0
    while ! flock -n 9 2>/dev/null; do
        i=$((i + 1))
        if [ "$i" -ge 8 ]; then
            logger -t TohsakaWrt-Uplink "Another switch is in progress, giving up after ${i}s"
            return 1
        fi
        sleep 1
    done
    return 0
}

# 回落标记与冷却：都在 /tmp（重启即清，符合"临时状态"的语义）
FALLBACK_MARK="${TOHSAKA_UPLINK_FALLBACK:-/tmp/tohsakawrt/state/uplink_fallback}"
RECONCILE_FAIL="${TOHSAKA_UPLINK_RECONCILE_FAIL:-/tmp/tohsakawrt/state/uplink_reconcile_failed}"
FALLBACK_MAX_AGE=3600
RECONCILE_COOLDOWN=600

mark_fallback() {
    mkdir -p "$(dirname "$FALLBACK_MARK")" 2>/dev/null
    date +%s > "$FALLBACK_MARK" 2>/dev/null || true
}

clear_fallback() {
    rm -f "$FALLBACK_MARK" 2>/dev/null || true
}

# 回落标记是否仍然有效（超过 1 小时视为失效，避免标记卡死后自愈永久失效）
fallback_active() {
    [ -r "$FALLBACK_MARK" ] || return 1
    local ts="$(cat "$FALLBACK_MARK" 2>/dev/null)"
    case "$ts" in ''|*[!0-9]*) return 1 ;; esac
    local now="$(date +%s)"
    [ "$((now - ts))" -le "$FALLBACK_MAX_AGE" ] || return 1
    return 0
}

# reconcile 失败后的冷却（避免期望线路长期不通时每分钟重试造成抖动）
reconcile_cooling() {
    [ -r "$RECONCILE_FAIL" ] || return 1
    local ts="$(cat "$RECONCILE_FAIL" 2>/dev/null)"
    case "$ts" in ''|*[!0-9]*) return 1 ;; esac
    local now="$(date +%s)"
    [ "$((now - ts))" -lt "$RECONCILE_COOLDOWN" ]
}

read_desired() {
    [ -r "$DESIRED_FILE" ] || return 0
    sed -n '1p' "$DESIRED_FILE" 2>/dev/null | tr -d ' \r\n'
}

write_desired() {
    mkdir -p "$(dirname "$DESIRED_FILE")" 2>/dev/null
    printf '%s\n' "$1" > "$DESIRED_FILE" 2>/dev/null || true
}

# 走新出口做真实连通性探测：只要有一个公网目标通就算通。
# 为什么不止一个：只依赖 ICMP 时，对方封禁 ICMP 会让我们误判成断网并回滚 —— 那比不检查更糟。
probe_uplink() {
    local dev="$1"
    ping -c 2 -W 2 223.5.5.5 >/dev/null 2>&1 && return 0
    curl -s -m 5 -k -o /dev/null "https://1.1.1.1/" >/dev/null 2>&1 && return 0
    curl -s -m 5 -k -o /dev/null --interface "$dev" "https://1.1.1.1/" >/dev/null 2>&1 && return 0
    return 1
}

switch_to_wan() {
    local cur="$(get_active_uplink)"
    if [ "$cur" = "wan" ]; then
        echo "ALREADY_WAN"
        return 0
    fi

    local eth_gw="$(get_gateway eth0)"
    if [ -z "$eth_gw" ]; then
        logger -t TohsakaWrt-Uplink "WAN route validation failed: no default gateway on eth0"
        echo "ERROR_SWITCH_FAILED"
        return 1
    fi

    local usb_gw="$(get_gateway usb0)"
    if [ -n "$usb_gw" ]; then
        ip route del default via "$usb_gw" dev usb0 metric 1 2>/dev/null || true
        ip route del default via "$usb_gw" dev usb0 metric 5 2>/dev/null || true
    fi
    local active="$(ip route get 8.8.8.8 2>/dev/null)"
    local active_dev="$(printf '%s\n' "$active" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
    if [ "$active_dev" != "eth0" ]; then
        if [ -n "$usb_gw" ]; then
            ip route replace default via "$usb_gw" dev usb0 metric 1 2>/dev/null || true
            ip route replace default via "$usb_gw" dev usb0 metric 5 2>/dev/null || true
            logger -t TohsakaWrt-Uplink "Restored 5G default routes after WAN validation failure"
        fi
        logger -t TohsakaWrt-Uplink "WAN route validation failed: ${active:-no route to 8.8.8.8}"
        echo "ERROR_SWITCH_FAILED"
        return 1
    fi

    # 真实连通性探测：路由已指向 eth0，但未必真的能上网（光猫上游断网/拨号失败等）
    if ! probe_uplink eth0; then
        if [ -n "$usb_gw" ]; then
            ip route replace default via "$usb_gw" dev usb0 metric 1 2>/dev/null || true
            ip route replace default via "$usb_gw" dev usb0 metric 5 2>/dev/null || true
        fi
        logger -t TohsakaWrt-Uplink "WAN connectivity probe failed, rolled back to 5G"
        echo "ERROR_UNVERIFIED_WAN"
        return 1
    fi

    normalize_metrics
    if [ "${TOHSAKA_UPLINK_KEEP_DESIRED:-0}" = "1" ]; then
        # 临时回落：期望出口保持不变（否则 reconcile 会与回落互相打架）
        mark_fallback
    else
        clear_fallback
        write_desired wan
    fi
    logger -t TohsakaWrt-Uplink "Uplink switched to WAN (eth0)"
    echo "SUCCESS_WAN"
}

switch_to_5g() {
    local cur="$(get_active_uplink)"
    if [ "$cur" = "5g" ]; then
        echo "ALREADY_5G"
        return 0
    fi

    local ip_addr="$(ip -4 addr show usb0 2>/dev/null | awk '/inet / {print $2}')"
    local usb_gw="$(get_gateway usb0)"
    if [ -z "$ip_addr" ] || [ -z "$usb_gw" ]; then
        echo "ERROR_5G_NO_IP: 5G 接口 usb0 未获取到 IP 或网关"
        return 1
    fi

    local eth_gw="$(get_gateway eth0)"
    if [ -n "$eth_gw" ]; then
        ip route del default via "$eth_gw" dev eth0 metric 1 2>/dev/null || true
    fi
    ip route del default via "$usb_gw" dev usb0 metric 5 2>/dev/null || true
    ip route replace default via "$usb_gw" dev usb0 metric 1 || {
        echo "ERROR_SWITCH_FAILED: 添加 5G 优先路由失败"
        return 1
    }

    local active="$(ip route get 8.8.8.8 2>/dev/null)"
    local active_dev="$(printf '%s\n' "$active" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
    if [ "$active_dev" != "usb0" ]; then
        ip route del default via "$usb_gw" dev usb0 metric 1 2>/dev/null || true
        logger -t TohsakaWrt-Uplink "5G route validation failed: ${active:-no route to 8.8.8.8}"
        echo "ERROR_SWITCH_FAILED"
        return 1
    fi

    # 真实连通性探测：模组附着上了不代表数据面通
    if ! probe_uplink usb0; then
        ip route del default via "$usb_gw" dev usb0 metric 1 2>/dev/null || true
        logger -t TohsakaWrt-Uplink "5G connectivity probe failed, reverted route change"
        echo "ERROR_UNVERIFIED_5G"
        return 1
    fi

    normalize_metrics
    if [ "${TOHSAKA_UPLINK_KEEP_DESIRED:-0}" = "1" ]; then
        # 临时回落：期望出口保持不变（否则 reconcile 会与回落互相打架）
        mark_fallback
    else
        clear_fallback
        write_desired 5g
    fi
    logger -t TohsakaWrt-Uplink "Uplink switched to 5G (usb0)"
    echo "SUCCESS_5G"
}

# 出口对账主体（reconcile 与 resume 共用）
do_reconcile() {
    local reason="${1:-出口被改动}"
    local desired="$(read_desired)"
    [ -n "$desired" ] || return 0
    if [ "$(uci -q get tohsakawrt-tgbot.main.uplink_enforce 2>/dev/null)" = "0" ]; then
        return 0
    fi
    # 临时回落期间不纠偏：否则会与回落互相打架，来回切网
    if fallback_active; then
        logger -t TohsakaWrt-Uplink "Reconcile skipped: temporary fallback is active"
        return 0
    fi
    # 上次纠正失败后的冷却：避免期望线路长期不通时每分钟重试
    if reconcile_cooling; then
        logger -t TohsakaWrt-Uplink "Reconcile skipped: cooling down after a failed attempt"
        return 0
    fi

    local actual="$(get_active_uplink)"
    [ "$actual" = "$desired" ] && return 0

    logger -t TohsakaWrt-Uplink "Uplink drift detected (want ${desired}, actual ${actual}), re-applying"
    local result
    case "$desired" in
        wan|eth0) result="$(switch_to_wan)" ;;
        5g|usb0) result="$(switch_to_5g)" ;;
        *) return 0 ;;
    esac
    echo "$result"
    case "$result" in
        SUCCESS_*)
            rm -f "$RECONCILE_FAIL" 2>/dev/null || true
            if command -v send_tg >/dev/null 2>&1; then
                send_tg "♻️ <b>出口已自动纠正</b>
━━━━━━━━━━━━━━━━━━
🎯 <b>期望出口</b>：<code>${desired}</code>
📡 <b>纠正前实际</b>：<code>${actual}</code>
🧭 <b>触发原因</b>：${reason}
━━━━━━━━━━━━━━━━━━
<i>已按你的选择改回；期望出口不会被自动改动。</i>

🕰️ <i>$(date '+%Y-%m-%d %H:%M:%S')</i>" "HTML" "$TG_KB_STATUS_UPLINK" || true
            fi
            return 0
            ;;
        *)
            # 切不过去（例如期望的线路确实不通）：记冷却，避免每分钟重试造成抖动，并告知用户
            date +%s > "$RECONCILE_FAIL" 2>/dev/null || true
            if command -v send_tg >/dev/null 2>&1; then
                send_tg "⚠️ <b>出口纠正失败</b>
━━━━━━━━━━━━━━━━━━
🎯 <b>期望出口</b>：<code>${desired}</code>
📡 <b>当前实际</b>：<code>${actual}</code>
📄 <b>返回</b>：<code>${result:-no_result}</code>
━━━━━━━━━━━━━━━━━━
<i>该线路当前探测不通，已保持现状，${RECONCILE_COOLDOWN} 秒后才会再次尝试。</i>

🕰️ <i>$(date '+%Y-%m-%d %H:%M:%S')</i>" "HTML" "$TG_KB_STATUS_UPLINK" || true
            fi
            return 1
            ;;
    esac
}

case "$1" in
    status)
        cur="$(get_active_uplink)"
        dev="$(get_active_dev)"
        echo "ACTIVE:${cur}|${dev}"
        ;;
    check)
        # 供机器人菜单做"切换前预检"：只看线路前提（接口有 IP + 网关可达），
        # 本地探测、不耗公网流量、不经过代理。输出：READY / NO_IP / NO_GATEWAY / UNREACHABLE
        case "$2" in
            wan|eth0) check_dev=eth0 ;;
            5g|usb0) check_dev=usb0 ;;
            *) echo "USAGE"; exit 1 ;;
        esac
        check_ip="$(ip -4 addr show "$check_dev" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)"
        if [ -z "$check_ip" ]; then echo "NO_IP"; exit 0; fi
        check_gw="$(get_gateway "$check_dev")"
        if [ -z "$check_gw" ]; then echo "NO_GATEWAY"; exit 0; fi
        if ping -c 1 -W 2 "$check_gw" >/dev/null 2>&1; then echo "READY"; else echo "UNREACHABLE"; fi
        exit 0
        ;;
    reconcile)
        # 由巡检调用：实际出口与"期望出口"不一致时自动纠正
        acquire_uplink_lock || { echo "ERROR_BUSY"; exit 1; }
        do_reconcile "出口被改动"
        ;;
    resume)
        # 5G 恢复后由 modem-heal 调用：有回落标记就清掉并切回期望出口，否则什么都不做
        acquire_uplink_lock || { echo "ERROR_BUSY"; exit 1; }
        fallback_active || exit 0
        clear_fallback
        rm -f "$RECONCILE_FAIL" 2>/dev/null || true
        do_reconcile "5G 已恢复"
        ;;
    set)
        acquire_uplink_lock || { echo "ERROR_BUSY: 另一个出口切换正在进行"; exit 1; }
        case "$2" in
            wan|eth0) switch_to_wan ;;
            5g|usb0) switch_to_5g ;;
            *) echo "Usage: $0 set {wan|5g}"; exit 1 ;;
        esac
        ;;
    wan|eth0)
        acquire_uplink_lock || { echo "ERROR_BUSY: 另一个出口切换正在进行"; exit 1; }
        switch_to_wan
        ;;
    5g|usb0)
        acquire_uplink_lock || { echo "ERROR_BUSY: 另一个出口切换正在进行"; exit 1; }
        switch_to_5g
        ;;
    *)
        echo "Usage: $0 {status | check <wan|5g> | reconcile | resume | wan | 5g}"
        exit 1
        ;;
esac
