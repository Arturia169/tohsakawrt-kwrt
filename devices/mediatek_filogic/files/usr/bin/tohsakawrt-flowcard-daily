#!/usr/bin/lua
-- TohsakaWrt 流量卡每日用量报告（每晚 24:00 触发）
-- 走路由器专属 Telegram 机器人 (@RyanWrt1145_bot)
local core = require("tohsakawrt.core")
local tg = require("tohsakawrt.tg")
local json = require("luci.jsonc")

local STATE_FILE = "/etc/tohsakawrt/flowcard_daily.json"
-- 卡号不硬编码：从 uci 读取（凭据与卡号一律不入库）
local CARD_NO = tostring(core.get_uci("tohsakawrt-tgbot", "main", "flowcard_no", "") or ""):gsub("%s", "")

-- 预警阈值（可在 uci 里改：tohsakawrt-tgbot.main.flowcard_*）
local function cfg_num(key, default)
    local v = tonumber(tostring(core.get_uci("tohsakawrt-tgbot", "main", key, tostring(default)) or ""))
    if not v then return default end
    return v
end
local WARN_PERCENT = cfg_num("flowcard_warn_percent", 20)
local URGENT_PERCENT = cfg_num("flowcard_urgent_percent", 10)
local WARN_DAYS = cfg_num("flowcard_warn_days", 3)

-- 到期时间兼容三种返回：秒级时间戳 / 毫秒级时间戳 / "YYYY-MM-DDThh:mm:ss"（或省略年份）
local function parse_expiry(v)
    if type(v) == "number" then
        if v > 100000000000 then return math.floor(v / 1000) end
        return v
    end
    local s = tostring(v or "")
    if s:match("^%d%d%d%d%d+$") then
        local n = tonumber(s)
        if n and n > 100000000000 then return math.floor(n / 1000) end
        return n
    end
    local y, mo, d, h, mi = s:match("(%d%d%d%d)-(%d%d)-(%d%d)T(%d%d):(%d%d)")
    if not y then
        mo, d, h, mi = s:match("(%d%d)-(%d%d)T(%d%d):(%d%d)")
        if not mo then return nil end
        y = tostring(os.date("%Y"))
    end
    return os.time({ year = tonumber(y), month = tonumber(mo), day = tonumber(d), hour = tonumber(h), min = tonumber(mi), sec = 0 })
end

local function format_bar(percent)
    local filled = math.floor((percent or 0) / 10 + 0.5)
    if filled < 0 then filled = 0 end
    if filled > 10 then filled = 10 end
    local empty = 10 - filled
    return string.rep("█", filled) .. string.rep("░", empty)
end

local function quota_icon(percent)
    if percent > 50 then return "🟢"
    elseif percent > 20 then return "🟡"
    else return "🔴" end
end

local function load_state()
    local f = io.open(STATE_FILE, "r")
    if not f then return {} end
    local content = f:read("*a")
    f:close()
    if not content or content == "" then return {} end
    return json.parse(content) or {}
end

local function save_state(state)
    core.exec("mkdir -p /etc/tohsakawrt")
    local f = io.open(STATE_FILE, "w")
    if f then
        f:write(json.stringify(state))
        f:close()
    end
end

local FAILURE_NOTICE = "❌ <b>流量卡每日用量统计失败</b>：接口数据读取或格式化异常"

local ok, err = pcall(function()
    -- 1. 请求卡商官方接口
    local card_no = tostring(CARD_NO or ""):gsub("%s", "")
    if card_no == "" then
        core.log("Flowcard", "流量卡号未配置（uci tohsakawrt-tgbot.main.flowcard_no），跳过本次报表")
        return
    end
    local payload = json.stringify({ card_no = card_no, iccid = "" })
    local tmp = "/tmp/flowcard_req.json"
    local f = assert(io.open(tmp, "w"), "cannot create request file")
    assert(f:write(payload))
    assert(f:close())

    local cmd = string.format("curl -s -m 15 -X POST 'https://xlwlwl.com/api/v1/wechat/card-login' -H 'Content-Type: application/json' --data-binary @%s", tmp)
    local out = core.exec(cmd)
    os.remove(tmp)
    if not out or out == "" then error("empty API response") end

    local res = json.parse(out)
    if type(res) ~= "table" or tonumber(res.code) ~= 200 or type(res.data) ~= "table" or type(res.data.card) ~= "table" then
        error("invalid API response")
    end

    local card = res.data.card
    local total_mb = tonumber(tostring(card.total_flow or "")) or 102400
    local used_mb = tonumber(tostring(card.used_flow or "")) or 0
    local left_mb = tonumber(tostring(card.left_flow or "")) or 0
    local total_gb, used_gb, left_gb = total_mb / 1024, used_mb / 1024, left_mb / 1024
    local percent = total_mb > 0 and (left_mb / total_mb * 100) or 0
    if percent > 100 then percent = 100 elseif percent < 0 then percent = 0 end

    -- 2. 对比昨日累计已用，计算今日消耗
    local state = load_state()
    if type(state) ~= "table" then state = {} end
    local today_str = os.date("%Y-%m-%d")
    local last_used_mb = tonumber(tostring(state.last_used_mb or ""))
    local delta_text = "首日基线建立（明日起显示精准差值）"
    local delta_mb = nil
    if last_used_mb then
        delta_mb = used_mb - last_used_mb
        if delta_mb < 0 then delta_mb = used_mb end
        local delta_gb = delta_mb / 1024
        if delta_gb >= 1.0 then
            delta_text = string.format("%.2f GB", delta_gb)
        else
            delta_text = string.format("%.1f MB (%.2f GB)", delta_mb, delta_gb)
        end
    end

    -- 2.5 预警判定（必须在保存台账之前，才能读到"昨日"的用量数据）
    local warnings, urgent = {}, false
    local prev_urgent = tostring(state.urgent_state or "") == "1"

    local expiry_display = tostring(card.package_end_time or "未知")
    if expiry_display:match("(%d%d%-%d%d)T(%d%d:%d%d)") then
        expiry_display = expiry_display:gsub(".*(%d%d%-%d%d)T(%d%d:%d%d).*", "%1 %2")
    end

    local end_ts = parse_expiry(card.package_end_time)
    local days_left = nil
    if end_ts then days_left = math.floor((end_ts - os.time()) / 86400) end

    if days_left then
        if days_left < 0 then
            warnings[#warnings + 1] = string.format("🚨 <b>套餐已到期</b>（%s）", expiry_display)
            urgent = true
        elseif days_left <= WARN_DAYS then
            warnings[#warnings + 1] = string.format("⏳ <b>套餐 %d 天后到期</b>（%s）", days_left, expiry_display)
            if days_left <= 1 then urgent = true end
        end
    end

    if percent <= URGENT_PERCENT then
        local est = ""
        if delta_mb and delta_mb > 0 then
            est = string.format("，按今日速度约可用 %.0f 天", left_mb / delta_mb)
        end
        warnings[#warnings + 1] = string.format("🚨 <b>剩余流量不足 %.0f%%</b>：剩 <code>%.2f GB</code>%s", percent, left_gb, est)
        urgent = true
    elseif percent <= WARN_PERCENT then
        warnings[#warnings + 1] = string.format("⚠️ <b>剩余流量偏低 %.0f%%</b>：剩 <code>%.2f GB</code>", percent, left_gb)
    end

    local prev_delta = tonumber(tostring(state.last_delta_mb or ""))
    if prev_delta and prev_delta > 0 and last_used_mb and delta_mb and delta_mb > prev_delta * 3 and delta_mb > 1024 then
        warnings[#warnings + 1] = string.format("📈 <b>今日用量偏高</b>：<code>%.2f GB</code>（昨日 <code>%.2f GB</code>）", delta_mb / 1024, prev_delta / 1024)
    end

    -- 3. 保存新台账
    state.last_record_date = tostring(today_str)
    state.last_used_mb = used_mb
    state.last_updated_at = os.time()
    if delta_mb then state.last_delta_mb = delta_mb end
    state.urgent_state = urgent and "1" or "0"
    -- 只查询模式（机器人点「查流量」）不能写台账：否则当晚日报的"今日消耗"差值会被算错
    if os.getenv("FLOWCARD_PRINT_ONLY") ~= "1" then
        save_state(state)
    end

    -- 4. 组装并发送 Telegram HTML 报表
    local icon = quota_icon(percent)
    local operator = tostring(card.operator_name or "中国联通")
    local package = tostring(card.package_name or "100G/月享套餐")
    local expiry = tostring(card.package_end_time or "未知")
    local expiry_short = expiry:match("(%d%d%-%d%d)T(%d%d:%d%d)")
    if expiry_short then expiry = expiry:gsub(".*(%d%d%-%d%d)T(%d%d:%d%d).*", "%1 %2") end
    local lines = {
        "<b>📶 5G 模组流量卡 · 每日消耗报表</b>", "━━━━━━━━━━━━━━━━━━",
        "📅 统计周期：<b>今日（截至 24:00）</b>",
        string.format("🔥 <b>今日消耗流量</b>：<code>%s</code>", tostring(delta_text)),
        string.format("• 本月累计已用：<code>%.2f GB</code>", used_gb),
        string.format("%s <code>[%s]</code>  <b>%.1f%%</b> 剩余", icon, format_bar(percent), percent),
        string.format("• 套餐剩余总量：<code>%.2f / %.2f GB</code>", left_gb, total_gb),
        string.format("• 运营商与套餐：%s | %s", operator, package),
        string.format("• 额度重置周期：<code>%s</code>", tostring(expiry)), "━━━━━━━━━━━━━━━━━━",
        "💡 <i>由路由器 TohsakaWrt 模组管家自动送达</i>"
    }

    -- 预警插在标题之后，最显眼的位置
    if #warnings > 0 then
        table.insert(lines, 3, "⚠️ <b>需要注意</b>")
        for i = #warnings, 1, -1 do
            table.insert(lines, 4, "• " .. warnings[i])
        end
    end
    local kb = { { { text = "🩺 查状态", callback_data = "refresh_status" },
                    { text = "📶 查模组", callback_data = "refresh_modem" } } }
    if os.getenv("FLOWCARD_PRINT_ONLY") == "1" then
        -- 只把报表打到标准输出，交给机器人转发
        print(table.concat(lines, "\n"))
        os.exit(0)
    end
    assert(tg.send_msg(table.concat(lines, "\n"), kb) ~= nil, "Telegram report send failed")

    -- 紧急预警额外单独推一条（只在"从正常变为紧急"时发一次，不会天天骚扰）
    if urgent and not prev_urgent then
        local alert_kb = { { { text = "🩺 查状态", callback_data = "refresh_status" } } }
        pcall(tg.send_msg, string.format(
            "🚨 <b>流量卡预警</b>\n\n%s\n\n剩余额度：<b>%.1f%%</b>（%.2f / %.2f GB）",
            table.concat(warnings, "\n"), percent, left_gb, total_gb), alert_kb)
    end
end)

if not ok then
    core.log("Flowcard", "Daily report failed: " .. tostring(err))
    pcall(tg.send_msg, FAILURE_NOTICE)
end
