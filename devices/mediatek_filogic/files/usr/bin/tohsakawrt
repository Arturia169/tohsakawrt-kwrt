#!/bin/sh
# TohsakaWrt 统一管理控制台
# 说明：真正的实现全部在 Lua（/usr/lib/lua/tohsakawrt/cli.lua）。
# 这里只保留 watch 的入口与到 Lua 的转发，避免同一个功能存在两份实现。
# （原文件里另有一份 168 行的 shell 回退实现，因 Lua 引擎始终存在而永远不会被执行，已删除。）

if [ "$1" = "watch" ]; then
    shift
    case "$1" in
        temp)    exec /usr/bin/tohsakawrt-temp-watch ;;
        service) exec /usr/bin/tohsakawrt-service-watch ;;
        heal)    exec /usr/bin/tohsakawrt-modem-heal ;;
        *)       exec /usr/bin/tohsakawrt-watch ;;
    esac
fi

if [ -f /usr/lib/lua/tohsakawrt/cli.lua ]; then
    exec lua /usr/lib/lua/tohsakawrt/cli.lua "$@"
fi

echo "tohsakawrt: Lua 引擎缺失（/usr/lib/lua/tohsakawrt/cli.lua）" >&2
exit 127
