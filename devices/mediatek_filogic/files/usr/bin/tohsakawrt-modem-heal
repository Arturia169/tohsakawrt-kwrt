#!/bin/sh

AT_PORT="${TWR_HEAL_AT_PORT:-$(uci -q get modem.modem0.at_port || echo '/dev/ttyUSB3')}"
[ -e "$AT_PORT" ] || [ "${TWR_HEAL_AT_PORT_FAKE:-0}" = "1" ] || AT_PORT="/dev/ttyUSB3"
[ -e "$AT_PORT" ] || [ "${TWR_HEAL_AT_PORT_FAKE:-0}" = "1" ] || AT_PORT="/dev/ttyUSB2"
AT_SCRIPT="${TWR_HEAL_AT_SCRIPT:-/usr/share/modem/modem_at.sh}"
NET_CLASS_DIR="${TWR_HEAL_NET_CLASS_DIR:-/sys/class/net}"
MM_INIT="${TWR_MM_INIT:-/etc/init.d/modemmanager}"
UCI_NS="sms_manager"
UCI_SEC="sms_manager.@sms_manager[0]"
STATE_DIR="${TWR_STATE_DIR:-/tmp}"
# eSIM 后台任务的状态目录（与 esim.lua 的 STATE 保持一致；测试可覆盖）
ESIM_STATE_DIR="${TWR_ESIM_STATE_DIR:-/tmp/tohsakawrt/state}"
STATE_FILE="$STATE_DIR/tohsakawrt-modem-heal.restart"
LOCKED_STATE_FILE="$STATE_DIR/tohsakawrt-modem-heal.locked-restart"
LOCK_DIR="$STATE_DIR/tohsakawrt-modem-heal.lock"
WAIT_STEPS=30
WAIT_INTERVAL=1
RESTART_MIN_INTERVAL=120

# AT 口健康计数：由 heal_cellular_data 按"本轮 AT+QCCID 是否读取成功"维护。
# 连续失败达到阈值即判定当前 AT 口失效，触发换口。
# 关键：这里复用的是脚本本来就每分钟执行的 ICCID 读取结果，
# 因此正常运行时**不产生任何额外 AT 流量**（实测一次 ATI 约 48ms/43ms CPU，
# 而 modem_debug.sh 每次要 source 147KB 厂商脚本，能省则省）。
AT_HEALTH_FILE="$STATE_DIR/tohsakawrt-5g-data.at-fail"
AT_HEALTH_THRESHOLD="${TWR_AT_HEALTH_THRESHOLD:-3}"

# 判断某个串口是否真的能应答 AT。
# ttyUSB0 是诊断口、ttyUSB1 是 GPS，都不应答 AT —— 必须实测，不能靠编号猜。
# 定义在此处是为了让文件开头的"节点消失自救"也能调用它。
at_port_probe_ok() {
    local port="$1" reply
    [ -c "$port" ] || return 1
    reply="$(AT_TIMEOUT=3 sh "$AT_SCRIPT" "$port" 'ATI' 2>/dev/null)"
    case "$reply" in
        *Quectel*|*RM500Q*|*OK*) return 0 ;;
        *) return 1 ;;
    esac
}

VERBOSE=0
[ "${1:-}" = "--verbose" ] && VERBOSE=1

[ -r /usr/lib/tohsakawrt/common.sh ] && . /usr/lib/tohsakawrt/common.sh

say() {
    [ "$VERBOSE" -eq 1 ] && printf '%s\n' "$*"
    return 0
}

# 确保"永远有一条能上网的出口"：5G 不通时把默认出口退到有线宽带。
# 用 KEEP_DESIRED=1，保留用户"期望出口=5g"的选择，5G 恢复后由 resume 自动切回。
ensure_wan_fallback() {
    local reason="${1:-5g-down}"
    [ "$(uci -q get tohsakawrt-tgbot.main.uplink_auto_fallback 2>/dev/null)" = "0" ] && {
        say "auto fallback disabled by uci"
        return 1
    }
    [ -x /usr/bin/tohsakawrt-uplink ] || return 1

    case "$(/usr/bin/tohsakawrt-uplink status 2>/dev/null)" in
        ACTIVE:wan*) return 0 ;;
    esac

    if [ "$(/usr/bin/tohsakawrt-uplink check wan 2>/dev/null)" != "READY" ]; then
        logger -t tohsakawrt-modem-heal "回落宽带失败：宽带前提不就绪（reason=${reason}）"
        return 1
    fi

    TOHSAKA_UPLINK_KEEP_DESIRED=1 /usr/bin/tohsakawrt-uplink set wan >/dev/null 2>&1
    case "$(/usr/bin/tohsakawrt-uplink status 2>/dev/null)" in
        ACTIVE:wan*)
            logger -t tohsakawrt-modem-heal "已回落到有线宽带（reason=${reason}）"
            return 0
            ;;
    esac
    logger -t tohsakawrt-modem-heal "回落宽带失败：切换未生效（reason=${reason}）"
    return 1
}

say "check AT port: $AT_PORT"

# 持久化的 at_port 指向不存在的设备节点时，实测找出可用口并写回 uci。
# 为什么必须单独做：文件开头第 3-5 行只会在**内存里**把 AT_PORT 挪到 ttyUSB3/ttyUSB2，
# 并不会修正 uci —— 于是机器人（modem.lua 的 get_port）、巡检脚本等其它读取者
# 依旧会拿到那个已经消失的设备路径。此块仅在 uci 值失效时执行，正常运行零开销。
UCI_AT_PORT="$(uci -q get modem.modem0.at_port 2>/dev/null)"
if [ -n "$UCI_AT_PORT" ] && [ ! -c "$UCI_AT_PORT" ]; then
    for cand in /dev/ttyUSB3 /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0; do
        [ -c "$cand" ] || continue
        if at_port_probe_ok "$cand"; then
            logger -t tohsakawrt-modem-heal "持久化的 AT 口 ${UCI_AT_PORT} 节点不存在，实测改用 ${cand}"
            uci set modem.modem0.at_port="$cand" 2>/dev/null && uci commit modem 2>/dev/null
            AT_PORT="$cand"
            break
        fi
    done
fi

[ -c "$AT_PORT" ] || { [ "${TWR_HEAL_AT_PORT_FAKE:-0}" = "1" ] && [ -f "$AT_PORT" ]; } || exit 0

MODEM_NET="$(uci -q get modem.modem0.network 2>/dev/null)"
[ -n "$MODEM_NET" ] || MODEM_NET="usb0"
ACTIVE_DEV="$(ip route get 8.8.8.8 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
UPLINK_IS_MODEM=0
[ -n "$ACTIVE_DEV" ] && [ "$MODEM_NET" = "$ACTIVE_DEV" ] && UPLINK_IS_MODEM=1
say "modem network: $MODEM_NET; active uplink dev: ${ACTIVE_DEV:-<unknown>}; uplink_is_modem: $UPLINK_IS_MODEM"

if [ "$VERBOSE" -eq 0 ]; then
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        if [ ! -d "$LOCK_DIR" ]; then
            logger -t tohsakawrt-modem-heal "Unable to create lock directory: $LOCK_DIR"
            exit 0
        fi
        LOCK_PID="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
        case "$LOCK_PID" in
            ''|*[!0-9]*) LOCK_STALE=1 ;;
            *)
                if kill -0 "$LOCK_PID" 2>/dev/null; then
                    # 关键：仅凭 kill -0 无法识别"活着但已经卡死"的进程。
                    # 原先这里无条件跳过，于是一个永久阻塞的运行会永久占住锁，
                    # 而且顶层 watch 锁也被它held，整套巡检静默死亡、只能重启路由器。
                    # 叠加年龄硬上限作为兜底（配合有界执行，正常单次运行远不会达到）。
                    if twr_lock_is_hung "$LOCK_DIR"; then
                        logger -t tohsakawrt-modem-heal "Lock held by LIVE pid ${LOCK_PID} for $(twr_lock_age "$LOCK_DIR")s (>${TWR_LOCK_MAX_AGE}s) — 判定为卡死，强制回收"
                        LOCK_STALE=1
                    else
                        logger -t tohsakawrt-modem-heal "Previous run still active, skip"
                        exit 0
                    fi
                else
                    LOCK_STALE=1
                fi
                ;;
        esac
        if [ "$LOCK_STALE" -eq 1 ]; then
            logger -t tohsakawrt-modem-heal "Removing stale lock (pid=${LOCK_PID:-missing})"
            rm -f "$LOCK_DIR/pid" 2>/dev/null
            if ! rmdir "$LOCK_DIR" 2>/dev/null; then
                logger -t tohsakawrt-modem-heal "Unable to remove stale lock directory: $LOCK_DIR"
                exit 0
            fi
            if ! mkdir "$LOCK_DIR" 2>/dev/null; then
                if [ -d "$LOCK_DIR" ]; then
                    logger -t tohsakawrt-modem-heal "Another run acquired the lock, skip"
                else
                    logger -t tohsakawrt-modem-heal "Unable to reacquire lock directory: $LOCK_DIR"
                fi
                exit 0
            fi
        fi
    fi
    if ! printf '%s\n' "$$" > "$LOCK_DIR/pid"; then
        rm -f "$LOCK_DIR/pid" 2>/dev/null
        rmdir "$LOCK_DIR" 2>/dev/null
        logger -t tohsakawrt-modem-heal "Unable to write lock pid: $LOCK_DIR/pid"
        exit 0
    fi
    lock_cleanup() {
        rm -f "$LOCK_DIR/pid" 2>/dev/null
        rmdir "$LOCK_DIR" 2>/dev/null
    }
    trap 'lock_cleanup' EXIT
    trap 'lock_cleanup; exit 130' INT
    trap 'lock_cleanup; exit 143' TERM
fi

get_index() {
    # 必须有界：mmcli 通过 D-Bus 通信，ModemManager 繁忙或卡顿时会长时间不返回。
    # 原先这里是裸调用，而它在下面的 30 次轮询循环里被反复调用 ——
    # 一旦每次阻塞，单次 heal 就能拖到十几分钟，把顶层看门狗锁长期占住。
    twr_timeout 10 mmcli -L 2>/dev/null | awk '
        match($0, /\/Modem\/[0-9]+/) {
            print substr($0, RSTART + 7, RLENGTH - 7)
            exit
        }
    '
}

# eSIM 后台任务是否还在跑：有 .spec 但还没有 .txt 的，视为未完成。
# 只认最近 10 分钟内的 .spec，避免 worker 崩溃留下的旧文件永久挡住自愈。
esim_job_active() {
    local spec txt
    for spec in "$ESIM_STATE_DIR"/esim-job-*.spec; do
        [ -e "$spec" ] || continue
        txt="${spec%.spec}.txt"
        [ -e "$txt" ] && continue
        [ -n "$(find "$spec" -mmin -10 2>/dev/null)" ] && return 0
    done
    return 1
}

# AT 端口漂移纠正。
# 根因（固件行为，已定位到代码）：USB 重新枚举时 hotplug 走 modem_util.sh 的 remove 分支，
# 因 modem.@global[0].manual_configuration=0 而调用 m_del_modem_config 删除整个 modem0 段；
# 随后 bind 分支重建该段，m_set_usb_at_port 发现 at_port 为空，就逐个串口探 ATI，
# 选中第一个能应答的 —— 也就是 ModemManager 自己占用的那个 AT 口（ttyUSB2）。
# 结果我们的 AT 通道与 ModemManager 抢同一条串口，命令与应答会错位。
# 这里每分钟对账一次，把 at_port 钉回"ModemManager 标记为未占用"的串口。
reconcile_at_port() {
    local current pick desired candidates at_fails
    current="$(uci -q get modem.modem0.at_port 2>/dev/null)"
    [ -n "$current" ] || return 0

    # 注意：mmcli 输出的 ports 行会折行，形如
    #   |  ports: ttyUSB0 (ignored), ttyUSB1 (gps), ttyUSB2 (at),
    #   |         ttyUSB3 (ignored),
    # 因此必须用 grep -o 跨行抓取全部带标注的端口，只取第一行会漏掉折到下一行的 ttyUSB3，
    # 误选到 ttyUSB0（诊断口，不应答 AT）。
    # 按编号从大到小排序，优先用编号大的（RM500Q-GL 上 ttyUSB3 是第二个 AT 口）。
    candidates="$(printf '%s\n' "$MODEM_INFO" \
        | grep -o 'ttyUSB[0-9][0-9]* (ignored)' \
        | sed 's/^ttyUSB//; s/ (ignored)$//' \
        | sort -rn)"

    # 上一轮 AT 读取的连续失败次数（健康时恒为 0，不产生任何额外探测）
    at_fails="$(cat "$AT_HEALTH_FILE" 2>/dev/null)"
    case "$at_fails" in ''|*[!0-9]*) at_fails=0 ;; esac

    # ---- 场景 A：当前口本身失效（不只是漂移）→ 逐个候选口实测，用第一个能应答的 ----
    if [ "$at_fails" -ge "$AT_HEALTH_THRESHOLD" ]; then
        for pick in $candidates; do
            desired="/dev/ttyUSB${pick}"
            [ "$desired" = "$current" ] && continue
            if at_port_probe_ok "$desired"; then
                logger -t tohsakawrt-modem-heal "AT 口 ${current} 连续 ${at_fails} 次读取失败，实测改用 ${desired}"
                uci set modem.modem0.at_port="${desired}" 2>/dev/null && uci commit modem 2>/dev/null
                printf '0\n' > "$AT_HEALTH_FILE" 2>/dev/null
                return 0
            fi
        done
        logger -t tohsakawrt-modem-heal "AT 口 ${current} 连续 ${at_fails} 次读取失败，候选口中亦无可用口"
        printf '0\n' > "$AT_HEALTH_FILE" 2>/dev/null
        return 0
    fi

    # ---- 场景 B：端口漂移（固件把 at_port 改成了 ModemManager 占用的口）----
    pick="$(printf '%s\n' "$candidates" | head -n 1)"
    [ -n "$pick" ] || return 0
    desired="/dev/ttyUSB${pick}"
    [ "$current" = "$desired" ] && return 0

    # 候选口必须真的能应答 AT，避免把 at_port 指向诊断口而废掉全部 AT 功能
    if at_port_probe_ok "$desired"; then
        logger -t tohsakawrt-modem-heal "AT 端口漂移: ${current} -> ${desired}（避开 ModemManager 占用的口），已纠正"
        uci set modem.modem0.at_port="${desired}" 2>/dev/null && uci commit modem 2>/dev/null
    else
        logger -t tohsakawrt-modem-heal "AT 端口候选 ${desired} 无 AT 应答，保持 ${current} 不变"
    fi
    return 0
}

# 回收被 init 收养的孤立 mmcli 监控进程。
# 根因在 /usr/sbin/ModemManager-monitor：`mmcli -M | { ... } &` 中 $! 取的是
# 管道末段子 shell 的 PID，kill $CHILD 只杀掉子 shell，mmcli -M 从未被杀；
# 而它的 stdout 是管道，只有写数据时才会收到 SIGPIPE，模组平静时永远不写，
# 于是每次 ModemManager 重启都永久泄漏一个（实测每个约 7.8MB）。
reap_orphan_monitors() {
    local pid ppid reaped=0
    command -v pidof >/dev/null 2>&1 || return 0
    # 用 pidof 直接定位 mmcli，而不是遍历整个 /proc。
    # 实测：遍历 119 个进程需 262ms/次（每个进程 fork 一次 tr），
    # 而 pidof 方案仅 13.6ms/次 —— 19 倍差距，每分钟省下约 250ms。
    for pid in $(pidof mmcli 2>/dev/null); do
        tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q -- '-M' || continue
        ppid="$(awk '{print $4}' "/proc/${pid}/stat" 2>/dev/null)"
        # 只回收孤儿（父进程已死、被 init 收养）。在用的监控进程父进程是 ModemManager-monitor。
        [ "$ppid" = "1" ] || continue
        kill -9 "$pid" 2>/dev/null && reaped=$((reaped + 1))
    done
    [ "$reaped" -gt 0 ] && logger -t tohsakawrt-modem-heal "回收 ${reaped} 个孤立的 mmcli 监控进程"
    return 0
}

reap_orphan_monitors

INDEX="$(get_index)"
say "mmcli -L index: ${INDEX:-<none>}"
ACTIONS=""

if [ -z "$INDEX" ]; then
    NOW="$(date +%s 2>/dev/null)"
    LAST="$(cat "$STATE_FILE" 2>/dev/null)"
    RESTART=0
    case "$NOW:$LAST" in
        *[!0-9:]*|:*|*:) RESTART=1 ;;
        *) [ "$((NOW - LAST))" -ge "$RESTART_MIN_INTERVAL" ] && RESTART=1 ;;
    esac
    say "restart timestamp: ${LAST:-<absent>}; now: ${NOW:-<unknown>}; eligible: $RESTART"
    if [ "$RESTART" -eq 1 ]; then
        if [ "$UPLINK_IS_MODEM" -eq 1 ]; then
            logger -t tohsakawrt-modem-heal "skipped ModemManager restart: $MODEM_NET is the active uplink"
        else
            "$MM_INIT" restart >/dev/null 2>&1
            printf '%s\n' "$NOW" > "$STATE_FILE" 2>/dev/null
            ACTIONS="restarted ModemManager"
        fi
    fi
    STEP=1
    while [ -z "$INDEX" ] && [ "$STEP" -le "$WAIT_STEPS" ]; do
        sleep "$WAIT_INTERVAL"
        INDEX="$(get_index)"
        say "poll $STEP/$WAIT_STEPS index: ${INDEX:-<none>}"
        STEP=$((STEP + 1))
    done
    if [ -z "$INDEX" ]; then
        [ "$VERBOSE" -eq 1 ] && say "no modem index found after polling"
        logger -t tohsakawrt-modem-heal "No modem index found after ModemManager check"
        exit 0
    fi
fi

CANONICAL="/org/freedesktop/ModemManager1/Modem/$INDEX"
say "canonical modem path: $CANONICAL"
CONFIG_CHANGED=0
for OPTION in readport sendport ussdport atport; do
    VALUE="$(uci -q get "$UCI_SEC.$OPTION" 2>/dev/null)"
    say "uci $UCI_SEC.$OPTION: ${VALUE:-<empty>}"
    [ "$VALUE" = "$CANONICAL" ] || CONFIG_CHANGED=1
done
if [ "$CONFIG_CHANGED" -eq 1 ]; then
    for OPTION in readport sendport ussdport atport; do
        say "uci set $UCI_SEC.$OPTION=$CANONICAL"
        uci set "$UCI_SEC.$OPTION=$CANONICAL" >/dev/null 2>&1
    done
    uci commit "$UCI_NS" >/dev/null 2>&1
    ACTIONS="${ACTIONS:+$ACTIONS; }updated SMS port paths"
fi

MODEM_INFO="$(twr_timeout 15 mmcli -m "$INDEX" 2>/dev/null)"
reconcile_at_port
MODEM_STATE="$(printf '%s\n' "$MODEM_INFO" | sed -n 's/.*state:[[:space:]]*\([[:alpha:]_][[:alpha:]_]*\)[[:space:]]*$/\1/p' | head -n 1)"
say "mmcli -m $INDEX state: ${MODEM_STATE:-<unknown>}"

# ModemManager 在 eSIM 切换 / CFUN=1,1 射频复位期间会把 modem 置为 locked。
# 此时 mmcli --enable 直接报 "Cannot enable modem: device locked"，
# 唯一的恢复办法是重启 ModemManager（2026-10-17 实机复现：切换后短信面板
# 读不到短信、信号为空，mmcli 状态 locked；重启 + enable 后立即恢复）。
#
# 两种不能动的情况：
#   ① eSIM 任务还在跑 —— 它正在做 CFUN 复位，此刻重启 MM 只会再锁一次；
#      任务结束后下一轮巡检会恢复（esim.lua 也会在任务结束时触发一次 heal）。
#   ② 模组正在承载主出口 —— 与下面 disabled 分支同样的策略，不在主链路上动 MM。
if [ "$MODEM_STATE" = "locked" ]; then
    if esim_job_active; then
        say "locked: eSIM job is running, defer ModemManager recovery"
    elif [ "$UPLINK_IS_MODEM" -eq 1 ]; then
        say "locked: skipping ModemManager restart: $MODEM_NET is the active uplink"
    else
        NOW_LOCKED="$(date +%s 2>/dev/null)"
        LAST_LOCKED="$(cat "$LOCKED_STATE_FILE" 2>/dev/null)"
        RECOVER=0
        case "$NOW_LOCKED:$LAST_LOCKED" in
            *[!0-9:]*|:*|*:) RECOVER=1 ;;
            *) [ "$((NOW_LOCKED - LAST_LOCKED))" -ge "$RESTART_MIN_INTERVAL" ] && RECOVER=1 ;;
        esac
        say "locked restart timestamp: ${LAST_LOCKED:-<absent>}; now: ${NOW_LOCKED:-<unknown>}; eligible: $RECOVER"
        if [ "$RECOVER" -eq 1 ]; then
            "$MM_INIT" restart >/dev/null 2>&1
            printf '%s\n' "$NOW_LOCKED" > "$LOCKED_STATE_FILE" 2>/dev/null
            ACTIONS="${ACTIONS:+$ACTIONS; }restarted ModemManager (state=locked)"
            STEP=1
            while [ "$STEP" -le "$WAIT_STEPS" ]; do
                sleep "$WAIT_INTERVAL"
                INDEX="$(get_index)"
                [ -n "$INDEX" ] && break
                STEP=$((STEP + 1))
            done
            if [ -n "$INDEX" ]; then
                CANONICAL="/org/freedesktop/ModemManager1/Modem/$INDEX"
                MODEM_INFO="$(twr_timeout 15 mmcli -m "$INDEX" 2>/dev/null)"
                reconcile_at_port
                MODEM_STATE="$(printf '%s\n' "$MODEM_INFO" | sed -n 's/.*state:[[:space:]]*\([[:alpha:]_][[:alpha:]_]*\)[[:space:]]*$/\1/p' | head -n 1)"
                say "mmcli -m $INDEX state after restart: ${MODEM_STATE:-<unknown>}"
            else
                logger -t tohsakawrt-modem-heal "No modem index found after ModemManager restart (state=locked)"
            fi
        fi
    fi
fi

if [ "$MODEM_STATE" = "disabled" ]; then
    if [ "$UPLINK_IS_MODEM" -eq 1 ]; then
        say "skipping enable: $MODEM_NET is the active uplink"
    else
        # --enable 会触发真实的射频启用流程，ModemManager 要等它完成才回，故放宽到 20 秒
        twr_timeout 20 mmcli -m "$INDEX" --enable >/dev/null 2>&1
        ACTIONS="${ACTIONS:+$ACTIONS; }enabled modem"
    fi
fi

if [ -n "$ACTIONS" ]; then
    logger -t tohsakawrt-modem-heal "Modem $INDEX: $ACTIONS"
fi

heal_cellular_data() {
    local dev="usb0"

    local now="$(date +%s 2>/dev/null)"
    case "$now" in ''|*[!0-9]*) now=0 ;; esac
    local fail_count_file="$STATE_DIR/tohsakawrt-5g-data.fails"
    local first_fail_file="$STATE_DIR/tohsakawrt-5g-data.firstfail"
    local last_heal_file="$STATE_DIR/tohsakawrt-5g-data.lastheal"
    local active_alert_file="$STATE_DIR/tohsakawrt-5g-data.active-alert"
    local nodata_mode_file="$STATE_DIR/tohsakawrt-5g-data.nodata-mode"
    local last_iccid_file="$STATE_DIR/tohsakawrt-5g-data.last-iccid"

    local iccid=""
    local at_reply=""
    if [ -x "$AT_SCRIPT" ] && [ -e "$AT_PORT" ]; then
        local try=0
        while [ "$try" -lt 2 ]; do
            try=$((try + 1))
            at_reply="$(AT_TIMEOUT=3 sh "$AT_SCRIPT" "$AT_PORT" 'AT+QCCID' 2>/dev/null)"
            iccid="$(printf '%s\n' "$at_reply" | sed -n '/QCCID:/s/.*QCCID:[[:space:]]*//p' | tail -n 1 | tr -d '\"[:space:]' | tr '[:lower:]' '[:upper:]' | tr -cd '0-9A-F')"
            if [ -z "$iccid" ] || printf '%s' "$at_reply" | grep -qi 'ERROR'; then
                at_reply="$(AT_TIMEOUT=3 sh "$AT_SCRIPT" "$AT_PORT" 'AT+CCID' 2>/dev/null)"
                iccid="$(printf '%s\n' "$at_reply" | sed -n '/CCID:/s/.*CCID:[[:space:]]*//p' | tail -n 1 | tr -d '\"[:space:]' | tr '[:lower:]' '[:upper:]' | tr -cd '0-9A-F')"
            fi
            if [ -n "$iccid" ]; then break; fi
            sleep 1
        done
        if [ -n "$iccid" ]; then
            printf '%s\n' "$iccid" > "$last_iccid_file" 2>/dev/null
            # 读取成功 → AT 口健康，连续失败计数清零（正常运行时恒为 0，不触发任何额外探测）
            printf '0\n' > "$AT_HEALTH_FILE" 2>/dev/null
        else
            iccid="$(cat "$last_iccid_file" 2>/dev/null | tr -cd '0-9A-F')"
            [ -z "$iccid" ] || logger -t tohsakawrt-modem-heal "ICCID 实时读取失败，沿用上次成功值"
            # 读取失败 → 累加连续失败计数。达到阈值后由 reconcile_at_port 实测换口。
            # 用连续计数而非单次失败，是为了滤掉 AT 锁争用导致的偶发 AT_BUSY。
            local atf
            atf="$(cat "$AT_HEALTH_FILE" 2>/dev/null)"
            case "$atf" in ''|*[!0-9]*) atf=0 ;; esac
            printf '%s\n' "$((atf + 1))" > "$AT_HEALTH_FILE" 2>/dev/null
        fi
    fi

    local modem_data_heal="$(uci -q get tohsakawrt-tgbot.main.modem_data_heal 2>/dev/null)"
    local nodata_cards="$(uci -q get tohsakawrt-tgbot.main.nodata_cards 2>/dev/null)"
    local nodata_prefix=""
    if [ "$modem_data_heal" = "0" ]; then
        nodata_prefix="modem_data_heal=0"
    elif [ -n "$iccid" ]; then
        while IFS= read -r candidate; do
            candidate="$(printf '%s' "$candidate" | tr -d '\"[:space:]' | tr '[:lower:]' '[:upper:]' | tr -cd '0-9A-F')"
            [ -n "$candidate" ] || continue
            case "$iccid" in
                "$candidate"*) nodata_prefix="$candidate"; break ;;
            esac
        done <<EOF_NODATA
$(printf '%s\n' "$nodata_cards" | tr ' ' '\n')
EOF_NODATA
    fi

    local nodata_state="normal"
    [ -n "$iccid" ] || nodata_state="unknown"
    [ -n "$nodata_prefix" ] && nodata_state="silent:$nodata_prefix"
    local previous_nodata_state="$(cat "$nodata_mode_file" 2>/dev/null)"
    if [ "$nodata_state" != "$previous_nodata_state" ]; then
        case "$nodata_state" in
            silent:modem_data_heal=0) logger -t tohsakawrt-modem-heal "5G data heal paused by modem_data_heal=0" ;;
            silent:*) logger -t tohsakawrt-modem-heal "接码卡已识别（ICCID 前缀 ${nodata_state#silent:}）：暂停数据自愈" ;;
            unknown) logger -t tohsakawrt-modem-heal "ICCID 读取失败，按数据卡处理并继续数据自愈" ;;
            normal) [ -z "$previous_nodata_state" ] || logger -t tohsakawrt-modem-heal "已恢复数据自愈" ;;
        esac
        printf '%s\n' "$nodata_state" > "$nodata_mode_file" 2>/dev/null
    fi
    case "$nodata_state" in
        silent:*)
            rm -f "$fail_count_file" "$first_fail_file" "$last_heal_file" 2>/dev/null
            return 0
            ;;
    esac
    [ -d "$NET_CLASS_DIR/$dev" ] || return 0
    local ip="$(ip -4 addr show "$dev" 2>/dev/null | awk '/inet / {print $2}')"

    # 2. 独立链路心跳探测：绑定 usb0 网卡探测阿里 DNS (223.5.5.5) 或腾讯 DNS (119.29.29.29)
    # 此探测完全走 usb0，不影响主宽带流量，同时能防运营商 PDP 空闲断链
    local ping_ok=0
    if [ -n "$ip" ] && { ping -c 1 -W 2 -I "$dev" 223.5.5.5 >/dev/null 2>&1 || ping -c 1 -W 2 -I "$dev" 119.29.29.29 >/dev/null 2>&1; }; then
        ping_ok=1
    fi

    if [ "$ping_ok" -eq 1 ]; then
        # 探测成功，重置失败计数与复位额度（额度自愈后必须回满，否则下次故障会被直接判死）
        rm -f "$fail_count_file" 2>/dev/null
        rm -f "$first_fail_file" 2>/dev/null
        rm -f "$STATE_DIR/tohsakawrt-5g-data.reset-count" 2>/dev/null
        rm -f "$STATE_DIR/tohsakawrt-5g-data.reset-last" 2>/dev/null
        rm -f "$STATE_DIR/tohsakawrt-5g-data.network-denied" 2>/dev/null
        # 若此前因 5G 掉线临时回落到宽带，现在 5G 恢复 → 切回期望出口
        # （resume 自己判断有没有回落标记：没有就什么都不做，可以无条件调用）
        if [ -x /usr/bin/tohsakawrt-uplink ]; then
            /usr/bin/tohsakawrt-uplink resume >/dev/null 2>&1 || true
        fi
        say "5G data keepalive ping OK"
        return 0
    fi

    # 3. 探测失败：记录失败计数，执行阶梯式自愈
    local fails="$(cat "$fail_count_file" 2>/dev/null)"
    case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
    fails=$(( ${fails:-0} + 1 ))
    echo "$fails" > "$fail_count_file"
    if [ "$fails" -eq 1 ]; then
        echo "$now" > "$first_fail_file"
    fi
    say "5G data ping failed (count: $fails)"

    if [ "$UPLINK_IS_MODEM" -eq 1 ]; then
        logger -t tohsakawrt-modem-heal "5G data heal skipped: 5G 正在承载主出口，探测超时，已按策略不做动作"
        if [ "$fails" -ge 3 ]; then
            local last_alert="$(cat "$active_alert_file" 2>/dev/null)"
            case "$last_alert" in *[!0-9]*) last_alert=0 ;; esac
            if [ -z "$last_alert" ] || [ "$((now - last_alert))" -ge 1800 ]; then
                # 临时回落到宽带：只在宽带"前提就绪"时动作，
                # 且用 KEEP_DESIRED 保证不改动用户选择的期望出口
                local fell_back=0
                ensure_wan_fallback "main-uplink-timeout" && fell_back=1
                if command -v send_tg >/dev/null 2>&1; then
                    if [ "$fell_back" -eq 1 ]; then
                        send_tg "♻️ <b>5G 掉线，已临时切到有线宽带</b>\n━━━━━━━━━━━━━━━━━━\n📊 <b>探测结果</b>：连续 ${fails} 次数据探测超时\n🔄 <b>已执行动作</b>：临时回落到宽带\n🎯 <b>你的期望出口</b>：仍是原选择，5G 恢复后会自动切回\n━━━━━━━━━━━━━━━━━━\n\n🕰️ <i>$(date '+%Y-%m-%d %H:%M:%S')</i>" "HTML" "$TG_KB_STATUS_UPLINK"
                    else
                        send_tg "⚠️ <b>5G 主出口探测超时</b>\n━━━━━━━━━━━━━━━━━━\n📡 <b>探测结果</b>：5G 正在承载主出口，探测超时\n⛔ <b>未执行动作</b>：宽带未就绪或回落未成功\n━━━━━━━━━━━━━━━━━━\n\n🕰️ <i>$(date '+%Y-%m-%d %H:%M:%S')</i>" "HTML" "$TG_KB_STATUS_UPLINK"
                    fi
                fi
                echo "$now" > "$active_alert_file"
            fi
        fi
        return 0
    fi

    if [ -z "$ip" ]; then
        say "5G $dev has no IP; no-interface recovery is handled by the staged policy"
    fi

    local last_heal="$(cat "$last_heal_file" 2>/dev/null)"
    case "$last_heal" in ''|*[!0-9]*) last_heal=0 ;; esac
    local heal_interval=$((now - ${last_heal:-0}))

    # ---- Stage 1/2：轻量动作（重拨接口、重建 PDP），防抖 60 秒 ----
    if [ "$fails" -le 2 ]; then
        if [ "$heal_interval" -lt 60 ]; then
            say "heal throttled (last heal was ${heal_interval}s ago)"
            return 0
        fi
        echo "$now" > "$last_heal_file"
        if [ "$fails" -eq 1 ]; then
            logger -t tohsakawrt-modem-heal "5G data heal (Stage 1): ping timeout, triggering ifup 5Ga"
            # 必须有界：/sbin/ifup 每次都会先执行 `ubus call network reload`（重载整个网络配置），
            # 随后再下发 down/up —— 共 3 次 ubus 调用，且它不在任何超时保护内。
            # 若 netifd 或某个 proto 处理器卡住，ubus 默认 30 秒超时 ×3 会把看门狗锁占满。
            twr_timeout 45 ifup 5Ga 2>/dev/null
        else
            logger -t tohsakawrt-modem-heal "5G data heal (Stage 2): sending AT+QNETDEVCTL=1,1,1"
            if [ -x "$AT_SCRIPT" ] && [ -e "$AT_PORT" ]; then
                sh "$AT_SCRIPT" "$AT_PORT" 'AT+QNETDEVCTL=1,1,1' >/dev/null 2>&1
                sleep 2
                twr_timeout 45 ifup 5Ga 2>/dev/null
            fi
        fi
        return 0
    fi

    # ---- Stage 3 前置判据：先区分"射频故障"与"网络侧拒绝" ----
    # 流量卡欠费/停机/套餐到期时，网络会拒绝附着（AT+CEER 报 attach failed / denied）。
    # 这属于卡侧或网络侧问题，复位射频完全无效；更糟的是复位会打断正在进行的附着，
    # 把本可自愈的故障永久化。判定为网络侧拒绝时只回落宽带，绝不动射频。
    local ceer=""
    if [ -x "$AT_SCRIPT" ] && [ -e "$AT_PORT" ]; then
        ceer="$(AT_TIMEOUT=3 sh "$AT_SCRIPT" "$AT_PORT" 'AT+CEER' 2>/dev/null | sed -n 's/.*+CEER:[[:space:]]*//p' | tr -d '\r' | head -n 1)"
    fi
    case "$ceer" in
        *ttach*failed*|*enied*|*ENIED*|*not\ allowed*|*Illegal*|*illegal*)
            # 限频：每 10 分钟最多处理一次，避免每分钟刷日志
            local nd_file="$STATE_DIR/tohsakawrt-5g-data.network-denied"
            local nd_last="$(cat "$nd_file" 2>/dev/null)"
            case "$nd_last" in ''|*[!0-9]*) nd_last=0 ;; esac
            if [ "$((now - nd_last))" -ge 600 ]; then
                logger -t tohsakawrt-modem-heal "5G 被网络侧拒绝（${ceer}），判定非射频故障，跳过射频复位并回落宽带"
                ensure_wan_fallback "network-denied"
                printf '%s\n' "$now" > "$nd_file" 2>/dev/null
            fi
            return 0
            ;;
    esac

    local first_fail="$(cat "$first_fail_file" 2>/dev/null)"
    case "$first_fail" in ''|*[!0-9]*) first_fail=0 ;; esac
    local failure_duration=$((now - ${first_fail:-now}))

    # ---- Stage 3：射频复位必须有额度与退避，绝不无限重试 ----
    # 原实现缺陷：闸门"失败≥5 且持续≥300s"一旦满足就永久满足，而节流只有 60 秒；
    # 但完成一次 LTE/NR 重新附着需要 30~180 秒，于是复位每 60 秒打断一次附着，
    # 模组永远走不完注册流程（实测 fails 累积到 15、CSQ 恒为 99,99、QNWINFO 恒为 No Service）。
    local reset_count_file="$STATE_DIR/tohsakawrt-5g-data.reset-count"
    local reset_last_file="$STATE_DIR/tohsakawrt-5g-data.reset-last"
    local resets="$(cat "$reset_count_file" 2>/dev/null)"
    case "$resets" in ''|*[!0-9]*) resets=0 ;; esac

    if [ "$failure_duration" -lt 300 ] && [ "$resets" -eq 0 ]; then
        logger -t tohsakawrt-modem-heal "5G data heal (Stage 3): RF reset deferred (failures=$fails, duration=${failure_duration}s; need 300s)"
        return 0
    fi

    local backoff
    case "$resets" in
        0) backoff=60 ;;
        1) backoff=300 ;;
        2) backoff=900 ;;
        *)
            # 额度用尽：停止动射频，只保证不丢网并限频告警（每 30 分钟最多一次）
            local last_alert="$(cat "$active_alert_file" 2>/dev/null)"
            case "$last_alert" in *[!0-9]*) last_alert=0 ;; esac
            if [ -z "$last_alert" ] || [ "$((now - last_alert))" -ge 1800 ]; then
                logger -t tohsakawrt-modem-heal "5G 射频复位额度已用尽（${resets} 次），停止复位并保持宽带出口"
                ensure_wan_fallback "reset-exhausted"
                if command -v send_tg >/dev/null 2>&1; then
                    send_tg "🔴 <b>5G 链路持续异常，已停止自愈复位</b>\n━━━━━━━━━━━━━━━━━━\n📊 <b>已尝试</b>：射频复位 ${resets} 次均未恢复\n🛡️ <b>当前策略</b>：不再反复复位模组（避免打断附着），已退到有线宽带，网络不会中断\n💡 <b>建议排查</b>：流量卡是否欠费/停机、套餐是否到期、天线是否接好\n\n🕰️ <i>$(date '+%Y-%m-%d %H:%M:%S')</i>" "HTML" "$TG_KB_STATUS_MODEM"
                fi
                echo "$now" > "$active_alert_file"
            fi
            return 0
            ;;
    esac

    local last_reset="$(cat "$reset_last_file" 2>/dev/null)"
    case "$last_reset" in ''|*[!0-9]*) last_reset=0 ;; esac
    if [ "$last_reset" -ne 0 ] && [ "$((now - last_reset))" -lt "$backoff" ]; then
        say "reset throttled (backoff ${backoff}s, last reset $((now - last_reset))s ago)"
        return 0
    fi

    resets=$((resets + 1))
    echo "$resets" > "$reset_count_file"
    echo "$now" > "$reset_last_file"
    echo "$now" > "$last_heal_file"
    logger -t tohsakawrt-modem-heal "5G data heal (Stage 3): resetting cellular RF (attempt ${resets}/3, backoff was ${backoff}s)"
    if [ -x "$AT_SCRIPT" ] && [ -e "$AT_PORT" ]; then
        # 用 AT+CFUN=1,1 做整模组复归：比"CFUN=0 后 2 秒再 CFUN=1"可靠得多 ——
        # 若 CFUN=0 关掉射频后 CFUN=1 未送达，模组会永久停在无射频状态。
        sh "$AT_SCRIPT" "$AT_PORT" 'AT+CFUN=1,1' >/dev/null 2>&1
        sleep 10
        twr_timeout 45 ifup 5Ga 2>/dev/null
    fi
}

heal_cellular_data

exit 0
