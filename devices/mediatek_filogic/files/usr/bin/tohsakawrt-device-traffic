#!/bin/sh
# 各设备流量排行（数据来自 nlbwmon 的 nlbw 客户端）
#   show   输出可直接发 Telegram 的 HTML 排行（前 N 名，带条形）
#   raw    输出 machine-readable：mac<TAB>rx_kb<TAB>tx_kb<TAB>total_kb（按总量降序）
#
# 重要：busybox 的 awk 是 32 位整数，字节级数值（1e10）会溢出成 2147483647，
# 所以**先在 shell 里换算成 KB**（ash 用 64 位），再交给 awk 做显示运算。
set -u
TOPN="${TWR_TRAFFIC_TOPN:-8}"
TAB="$(printf '\t')"

fetch() {
    out="$(nlbw -c csv -g mac -o -t 1 2>/dev/null)"
    [ -n "$out" ] || out="$(nlbw -c csv -g mac -o 2>/dev/null)"
    [ -n "$out" ] || out="$(nlbw -c csv -g mac 2>/dev/null)"
    printf '%s' "$out"
}

RAW="$(fetch)"
[ -n "$RAW" ] || { echo "TRAFFIC_UNAVAILABLE"; exit 1; }

TMP="/tmp/devtraffic.$$"
: > "$TMP"
printf '%s\n' "$RAW" | tail -n +2 | while IFS="$TAB" read -r mac conns rx rxpk tx txpk; do
    mac="$(printf '%s' "${mac:-}" | tr -d '"')"
    case "$mac" in *:*) ;; *) continue ;; esac
    rx="${rx:-0}"; tx="${tx:-0}"
    case "$rx" in ''|*[!0-9]*) rx=0 ;; esac
    case "$tx" in ''|*[!0-9]*) tx=0 ;; esac
    rxk=$((rx / 1024))
    txk=$((tx / 1024))
    [ $((rxk + txk)) -gt 0 ] || continue
    printf '%s\t%d\t%d\t%d\n' "$mac" "$rxk" "$txk" "$((rxk + txk))" >> "$TMP"
done

sort -t"$TAB" -k4 -nr "$TMP" > "$TMP.s" 2>/dev/null
[ -s "$TMP.s" ] && mv "$TMP.s" "$TMP"

TOTAL_KB="$(awk -F'\t' '{ s += $4 } END { printf "%d", s + 0 }' "$TMP" 2>/dev/null)"
[ -n "$TOTAL_KB" ] || TOTAL_KB=0

if [ "${1:-show}" = "raw" ]; then
    cat "$TMP"
    rm -f "$TMP" "$TMP.s"
    exit 0
fi

TOP1="$(head -n 1 "$TMP" 2>/dev/null | cut -f4)"
[ -n "$TOP1" ] || TOP1=1
[ "$TOP1" -gt 0 ] 2>/dev/null || TOP1=1

awk -F'\t' -v top="$TOP1" -v n="$TOPN" -v tot="$TOTAL_KB" '
function human(kb) {
    if (kb >= 1048576) return sprintf("%.2f GB", kb / 1048576)
    if (kb >= 1024) return sprintf("%.1f MB", kb / 1024)
    return sprintf("%d KB", kb)
}
BEGIN {
    print "<b>📱 各设备流量排行</b>"
    print "━━━━━━━━━━━━━━━━━━"
    print "📦 本计费周期累计：<code>" human(tot + 0) "</code>"
    print "━━━━━━━━━━━━━━━━━━"
    cnt = 0
}
{
    cnt++
    if (cnt > n) next
    filled = int((($4 + 0) / (top + 0)) * 10 + 0.5)
    if (filled < 1) filled = 1
    if (filled > 10) filled = 10
    bar = ""
    for (i = 0; i < filled; i++) bar = bar "█"
    for (i = filled; i < 10; i++) bar = bar "░"
    printf "%d. <code>%s</code>  <code>[%s]</code>\n   ↓%s ↑%s\n", cnt, $1, bar, human($2 + 0), human($3 + 0)
}
END {
    print "━━━━━━━━━━━━━━━━━━"
    print "💡 <i>数据来自 nlbwmon；在机器人里给设备设备注后会显示名字。</i>"
}' "$TMP"
rm -f "$TMP" "$TMP.s"
