#!/bin/sh

TEMP_FILE="${TWR_TEMP_FILE:-/sys/class/thermal/thermal_zone0/temp}"

WARN_TEMP=80
CRITICAL_TEMP=90
RECOVER_TEMP=75

BARK_KEY="$(uci -q get tohsakawrt-tgbot.main.bark_key)"
BARK_API="https://api.day.app/push"

STATE_FILE="/tmp/tohsakawrt_temp_state"

[ -r /usr/lib/tohsakawrt/common.sh ] && . /usr/lib/tohsakawrt/common.sh

[ -r "$TEMP_FILE" ] || exit 0

RAW_TEMP="$(cat "$TEMP_FILE" 2>/dev/null)"
case "$RAW_TEMP" in
    ''|*[!0-9]*) logger -t TohsakaWrt-Temp "Invalid CPU temperature reading; skipping this check"; exit 0 ;;
esac

TEMP=$((RAW_TEMP / 1000))
NOW="$(date '+%m-%d %H:%M')"

STATE="$(cat "$STATE_FILE" 2>/dev/null)"
[ -n "$STATE" ] || STATE="normal"

if [ "$TEMP" -ge "$CRITICAL_TEMP" ]; then

    if [ "$STATE" != "critical" ]; then

        BODY="🚨 <b>高温警报</b>\n━━━━━━━━━━━━━━━━━━\n🌡️ <b>CPU 温度</b>：<code>$(html_escape "$TEMP")°C</code>\n🚨 <b>严重阈值</b>：<code>$(html_escape "$CRITICAL_TEMP")°C</code>\n🔴 <b>运行状态</b>：高温运行\n━━━━━━━━━━━━━━━━━━\n<i>建议尽快检查散热和设备负载。</i>\n\n🕰️ <i>$(html_escape "$NOW")</i>"

        push_bark             "🚨 高温警报"             "$BODY"             "critical"             "alarm"

        send_tg "$BODY" HTML

        logger -t TohsakaWrt-Temp             "CRITICAL CPU temperature ${TEMP}C"

        echo "critical" > "$STATE_FILE"
    fi

elif [ "$TEMP" -ge "$WARN_TEMP" ]; then

    if [ "$STATE" = "normal" ]; then

        BODY="⚠️ <b>温度预警</b>\n━━━━━━━━━━━━━━━━━━\n🌡️ <b>CPU 温度</b>：<code>$(html_escape "$TEMP")°C</code>\n⚠️ <b>预警阈值</b>：<code>$(html_escape "$WARN_TEMP")°C</code>\n⚠️ <b>运行状态</b>：温度偏高\n━━━━━━━━━━━━━━━━━━\n<i>请留意设备通风与当前负载。</i>\n\n🕰️ <i>$(html_escape "$NOW")</i>"

        push_bark             "⚠️ 温度预警"             "$BODY"             "timeSensitive"             "bell"

        send_tg "$BODY" HTML

        logger -t TohsakaWrt-Temp             "WARNING CPU temperature ${TEMP}C"

        echo "warning" > "$STATE_FILE"
    fi

elif [ "$TEMP" -le "$RECOVER_TEMP" ]; then

    if [ "$STATE" != "normal" ]; then

        BODY="✅ <b>温度恢复</b>\n━━━━━━━━━━━━━━━━━━\n🌡️ <b>CPU 温度</b>：<code>$(html_escape "$TEMP")°C</code>\n🟢 <b>恢复阈值</b>：<code>$(html_escape "$RECOVER_TEMP")°C</code>\n✅ <b>运行状态</b>：已恢复正常\n━━━━━━━━━━━━━━━━━━\n<i>设备温度已回落至安全范围。</i>\n\n🕰️ <i>$(html_escape "$NOW")</i>"

        push_bark             "✅ 温度恢复"             "$BODY"             "active"             "glass"

        send_tg "$BODY" HTML

        logger -t TohsakaWrt-Temp             "CPU temperature recovered to ${TEMP}C"

        echo "normal" > "$STATE_FILE"
    fi

fi

exit 0
