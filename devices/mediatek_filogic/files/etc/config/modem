
config global 'global'
	option enable_dial '1'
	option modem_number '1'
	option usb_scan '1'
	option pci_scan '1'
	option manual_configuration '0'
	option network_interface_alias '1'

config modem-device 'modem0'
	option data_interface 'usb'
	option path '/sys/devices/platform/soc/11200000.usb/usb2/2-1'
	option driver 'usb'
	option name 'rm500q-gl'
	option manufacturer 'quectel'
	list ports '/dev/ttyUSB0'
	list ports '/dev/ttyUSB1'
	list ports '/dev/ttyUSB2'
	list ports '/dev/ttyUSB3'
	option at_port '/dev/ttyUSB2'
	option net_driver 'cdc_ether'
	option network 'usb0'
	option network_interface 'usb0'
	option define_connect '1'
	option platform 'qualcomm'
	list modes 'qmi'
	list modes 'gobinet'
	list modes 'ecm'
	list modes 'mbim'
	list modes 'rndis'
	list modes 'ncm'

